"This share link is no longer valid. Please contact the sender for a new "
"link."
msgstr ""
"Deze deellink is niet meer geldig. Neem contact op met de afzender voor een "
"nieuwe link."

#. module: spreadsheet_public_share_oca
#: model_terms:ir.ui.view,arch_db:spreadsheet_public_share_oca.public_password_prompt
msgid "This shared spreadsheet is password-protected."
msgstr "Deze gedeelde spreadsheet is met een wachtwoord beveiligd."

#. module: spreadsheet_public_share_oca
#: model:ir.model.fields,help:spreadsheet_public_share_oca.field_spreadsheet_public_share__has_password
msgid ""
"Ticked when visitors must enter a password before the spreadsheet is shown."
msgstr ""
"Aangevinkt wanneer bezoekers een wachtwoord moeten invoeren voordat de "
"spreadsheet wordt getoond."

#. module: spreadsheet_public_share_oca
#: model:ir.model.fields,help:spreadsheet_public_share_oca.field_spreadsheet_public_share__last_viewed
