<odoo>
    <record id="res_config_settings_view_form_spreadsheet_share" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.spreadsheet.share</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="105" />
        <field
            name="inherit_id"
            ref="spreadsheet_kpi_alert_oca.res_config_settings_view_form_spreadsheet_kpi"
        />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='spreadsheet_oca']" position="inside">
                <block title="Public Share Links" name="share_settings_block">
                    <setting
                        help="Default expiry in days for new share links (0 = no expiry)."
                    >
                        <field name="public_share_default_expiry_days" />
                    </setting>
                    <setting help="Allow download on new share links by default.">
                        <field name="public_share_allow_download_default" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
