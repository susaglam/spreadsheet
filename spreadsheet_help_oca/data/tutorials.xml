<odoo noupdate="1">
    <!-- Tutorial records: pre-seeded, user can add video URLs and screenshots later -->

    <record id="tutorial_quick_start" model="spreadsheet.tutorial">
        <field name="name">🚀 Quick Start — Ilk Spreadsheet'inizi olusturun</field>
        <field name="sequence">10</field>
        <field
            name="description"
        >Odoo Spreadsheets uygulamasinin tum temelleri. Yeni bir spreadsheet olusturma, veri girme, kaydetme, template olarak kaydetme ve PDF olarak indirme. Interactive tour ile hemen baslayin!</field>
        <field name="module_name">spreadsheet_oca</field>
        <field name="duration_minutes">5</field>
        <field name="difficulty">beginner</field>
        <field name="tour_name">spreadsheet_quick_start</field>
        <field name="tags">quickstart,beginner,template,pdf</field>
    </record>

    <record id="tutorial_template_save" model="spreadsheet.tutorial">
        <field name="name">📋 Spreadsheet'i Template olarak kaydedin</field>
        <field name="sequence">20</field>
        <field
            name="description"
        >Sik kullandiginiz bir rapor sablonunu kaydedip tek tikla yeniden olusturun. 'File &gt; Save as Template' akisini gosteren interactive tour.</field>
        <field name="module_name">spreadsheet_template_oca</field>
        <field name="duration_minutes">3</field>
        <field name="difficulty">beginner</field>
        <field name="tour_name">spreadsheet_save_template</field>
        <field name="tags">template,sablon</field>
    </record>

    <record id="tutorial_kpi_alert" model="spreadsheet.tutorial">
        <field name="name">🔔 KPI Alert kurun</field>
        <field name="sequence">30</field>
        <field
            name="description"
        >Bir hucre belirli bir esigi astiginda bildirim alin. Smart button uzerinden alert olusturma, operator secimi, bildirim alicilari ayarlama. Discuss inbox ve chatter entegrasyonunu gosteren tour.</field>
        <field name="module_name">spreadsheet_kpi_alert_oca</field>
        <field name="duration_minutes">4</field>
        <field name="difficulty">intermediate</field>
        <field name="tour_name">spreadsheet_kpi_alert</field>
        <field name="tags">alert,kpi,notification,mail</field>
    </record>

    <record id="tutorial_public_share" model="spreadsheet.tutorial">
        <field name="name">🔗 Spreadsheet'i public link ile paylasin</field>
        <field name="sequence">40</field>
        <field
            name="description"
        >Musterilere veya dis ekibe spreadsheet'i read-only olarak paylasin. Parola korumasi, suresi dolma, indirme izni ayarlari.</field>
        <field name="module_name">spreadsheet_public_share_oca</field>
        <field name="duration_minutes">3</field>
        <field name="difficulty">beginner</field>
        <field name="tags">share,link,public,password</field>
    </record>

    <record id="tutorial_forecast" model="spreadsheet.tutorial">
        <field name="name">📈 Tahminleme fonksiyonlari</field>
        <field name="sequence">50</field>
        <field
            name="description"
        >ODOO.FORECAST, ODOO.TREND ve ODOO.MOVING_AVG ile gecmis verilerden gelecek tahminleri. Lineer regresyon ve hareketli ortalama ornekleri.</field>
        <field name="module_name">spreadsheet_forecast_oca</field>
        <field name="duration_minutes">5</field>
        <field name="difficulty">intermediate</field>
        <field name="guide_spreadsheet_id" ref="spreadsheet_help_oca.guide_forecast" />
        <field name="tags">formula,forecast,trend,moving_avg</field>
    </record>

    <record id="tutorial_period_comparison" model="spreadsheet.tutorial">
        <field name="name">📊 Donem karsilastirma</field>
        <field name="sequence">60</field>
        <field
            name="description"
        >Bu ay vs gecen ay, YoY (year-over-year), GROWTH_ARROW ile gorsel yuzde degisim. Dashboard'larda vazgecilmez fonksiyonlar.</field>
        <field name="module_name">spreadsheet_period_comparison_oca</field>
        <field name="duration_minutes">4</field>
        <field name="difficulty">beginner</field>
        <field name="guide_spreadsheet_id" ref="spreadsheet_help_oca.guide_period" />
        <field name="tags">formula,comparison,yoy,growth</field>
    </record>

    <record id="tutorial_contract" model="spreadsheet.tutorial">
        <field name="name">📝 Sozlesme ve SLA takibi</field>
        <field name="sequence">70</field>
        <field
            name="description"
        >Yillik sozlesmeleri takip edin, SLA metrikleri (uptime, response time) kaydedin, yaklasan bitis tarihleri icin otomatik email ve activity olusturun.</field>
        <field name="module_name">spreadsheet_contract_sla_oca</field>
        <field name="duration_minutes">6</field>
        <field name="difficulty">intermediate</field>
        <field name="tags">contract,sla,renewal,calendar</field>
    </record>

    <record id="tutorial_version_history" model="spreadsheet.tutorial">
        <field name="name">📸 Versiyon yedekleme ve geri alma</field>
        <field name="sequence">80</field>
        <field
            name="description"
        >Spreadsheet'in periyodik snapshot'lari. 'New Snapshot' butonu, versiyonlar arasi gorsel cell-level diff, rollback.</field>
        <field name="module_name">spreadsheet_version_history_oca</field>
        <field name="duration_minutes">4</field>
        <field name="difficulty">beginner</field>
        <field name="tags">version,snapshot,history,rollback</field>
    </record>

    <record id="tutorial_api" model="spreadsheet.tutorial">
        <field name="name">🔑 REST API ile entegrasyon</field>
        <field name="sequence">90</field>
        <field
            name="description"
        >Spreadsheet verisine dis sistemlerden (Power BI, Google Sheets, webhook'lar) erisim. Bearer token, rate limit, webhook delivery log.</field>
        <field name="module_name">spreadsheet_api_oca</field>
        <field name="duration_minutes">7</field>
        <field name="difficulty">advanced</field>
        <field name="tags">api,rest,integration,webhook,token</field>
    </record>

    <record id="tutorial_portal" model="spreadsheet.tutorial">
        <field name="name">👥 Portal uzerinden bayilere dashboard</field>
        <field name="sequence">100</field>
        <field
            name="description"
        >Portal kullanicilarinin (bayi/distributor) kendi verilerine ait read-only dashboard gorebilmesi. Record rule filter ile her bayiye kendi siparislerini gosterme.</field>
        <field name="module_name">spreadsheet_portal_dashboard_oca</field>
        <field name="duration_minutes">6</field>
        <field name="difficulty">advanced</field>
        <field name="tags">portal,dealer,dashboard,record_rule</field>
    </record>

    <record id="tutorial_consolidation" model="spreadsheet.tutorial">
        <field name="name">🏢 Multi-company konsolidasyon</field>
        <field name="sequence">110</field>
        <field
            name="description"
        >Birden cok sirketin bilancolarini tek bir konsolide rapora birlestirin. Currency conversion, inter-company elimination.</field>
        <field name="module_name">spreadsheet_multicompany_oca</field>
        <field name="duration_minutes">8</field>
        <field name="difficulty">advanced</field>
        <field name="tags">consolidation,multicompany,accounting</field>
    </record>

    <record id="tutorial_email_report" model="spreadsheet.tutorial">
        <field name="name">📧 Zamanli email raporlari</field>
        <field name="sequence">120</field>
        <field
            name="description"
        >Haftalik/aylik otomatik XLSX raporlarini ekibinize email ile gonderin. Mail template, cron tabanli delivery, send-now butonu.</field>
        <field name="module_name">spreadsheet_email_report_oca</field>
        <field name="duration_minutes">4</field>
        <field name="difficulty">intermediate</field>
        <field name="tags">email,scheduled,cron,report</field>
    </record>

    <!-- 2026-07-05: kalan 14 custom modul icin senaryo kayitlari eklendi,
         boylece her modulun "neden var" bilgisi yardim menusunde kalici. -->
    <record id="tutorial_dashboard_sale" model="spreadsheet.tutorial">
        <field name="name">📈 Satis analiz dashboard'u</field>
        <field name="sequence">130</field>
        <field
            name="description"
        >Satis ekibi performansini tek bakista gorun: Ciro, Siparis, Satilan Adet, Ortalama Siparis Degeri (onceki donemle karsilastirmali), aylik ciro trendi ve son siparisler. Satis temsilcisi ve urun kategorisi filtreleri. Dashboards > Sales altinda otomatik cikar.</field>
        <field name="module_name">spreadsheet_dashboard_sale_oca</field>
        <field name="duration_minutes">3</field>
        <field name="difficulty">beginner</field>
        <field name="tags">dashboard,sales,revenue,kpi</field>
    </record>

    <record id="tutorial_dashboard_crm" model="spreadsheet.tutorial">
        <field name="name">📊 CRM pipeline dashboard'u</field>
        <field name="sequence">140</field>
        <field
            name="description"
        >Acik firsatlar, beklenen ve prorate ciro, kazanilan anlasmalar; satis temsilcisi ve satis ekibi filtreleriyle. Satis yoneticisinin ceyreklik pipeline'i izlemesi icin. Dashboards > Sales.</field>
        <field name="module_name">spreadsheet_dashboard_crm_oca</field>
        <field name="duration_minutes">3</field>
        <field name="difficulty">beginner</field>
        <field name="tags">dashboard,crm,pipeline</field>
    </record>

    <record id="tutorial_dashboard_stock" model="spreadsheet.tutorial">
        <field name="name">📦 Stok / envanter dashboard'u</field>
        <field name="sequence">150</field>
        <field
            name="description"
        >Stok hareketleri: tamamlanan transferler, hareket eden adet, ortalama tedarik suresi, aylik hareket trendi ve son transferler; depo ve urun kategorisi filtreleriyle. Dashboards > Logistics.</field>
        <field name="module_name">spreadsheet_dashboard_stock_oca</field>
        <field name="duration_minutes">3</field>
        <field name="difficulty">beginner</field>
        <field name="tags">dashboard,stock,inventory,warehouse</field>
    </record>

    <record id="tutorial_dashboard_ecommerce" model="spreadsheet.tutorial">
        <field name="name">🛒 E-ticaret dashboard'u</field>
        <field name="sequence">160</field>
        <field
            name="description"
        >Web magazasi (website) satis KPI'lari: ciro, siparis sayisi, ortalama sepet, musteri; onceki donemle karsilastirma ve gunluk ciro trendi. NOT: yalnizca website siparislerini gosterir, bayi/toptan siparisleri haric.</field>
        <field name="module_name">spreadsheet_dashboard_ecommerce_oca</field>
        <field name="duration_minutes">3</field>
        <field name="difficulty">beginner</field>
        <field name="tags">dashboard,ecommerce,website</field>
    </record>

    <record id="tutorial_dashboard_hr" model="spreadsheet.tutorial">
        <field name="name">👤 Insan Kaynaklari dashboard'u</field>
        <field name="sequence">170</field>
        <field
            name="description"
        >Toplam calisan, yeni ise alim, departman ve pozisyon dagilimi, calisan rehberi; donem/departman/sirket filtreleriyle. Yalnizca Odoo IK modulu kullaniliyorsa anlamli. Dashboards > HR.</field>
        <field name="module_name">spreadsheet_dashboard_hr_oca</field>
        <field name="duration_minutes">3</field>
        <field name="difficulty">beginner</field>
        <field name="tags">dashboard,hr,employee</field>
    </record>

    <record id="tutorial_quote_conversion" model="spreadsheet.tutorial">
        <field name="name">🎯 Teklif → siparis donusum dashboard'u</field>
        <field name="sequence">180</field>
        <field
            name="description"
        >Kac teklifin siparise dondugunu ve donusum yuzdesini gorun. Satis hunisini ve teklif basari oranini izlemek icin bayi-satis odakli bir gosterge.</field>
        <field name="module_name">spreadsheet_quote_conversion_oca</field>
        <field name="duration_minutes">4</field>
        <field name="difficulty">intermediate</field>
        <field name="tags">dashboard,quote,conversion,funnel</field>
    </record>

    <record id="tutorial_vendor_scorecard" model="spreadsheet.tutorial">
        <field name="name">🏭 Tedarikci performans karnesi</field>
        <field name="sequence">190</field>
        <field
            name="description"
        >Tedarikcileri teslimat, kalite ve fiyat metrikleriyle puanlayin ve karsilastirin. Toptanci/bayi tedarik zincirinde hangi tedarikcinin iyi performans gosterdigini gormek icin.</field>
        <field name="module_name">spreadsheet_vendor_scorecard_oca</field>
        <field name="duration_minutes">5</field>
        <field name="difficulty">intermediate</field>
        <field name="tags">vendor,supplier,scorecard,purchase</field>
    </record>

    <record id="tutorial_stock_sales_correlation" model="spreadsheet.tutorial">
        <field name="name">🔗 Stok - satis korelasyonu</field>
        <field name="sequence">200</field>
        <field
            name="description"
        >Stok seviyesi ile satis hizini yan yana koyarak hangi urunlerde stok fazlasi veya eksigi oldugunu gorun — yeniden siparis (reorder) kararlari icin.</field>
        <field name="module_name">spreadsheet_stock_sales_correlation_oca</field>
        <field name="duration_minutes">5</field>
        <field name="difficulty">intermediate</field>
        <field name="tags">stock,sales,correlation,reorder</field>
    </record>

    <record id="tutorial_customer_segmentation" model="spreadsheet.tutorial">
        <field name="name">🧩 Musteri segmentasyonu</field>
        <field name="sequence">210</field>
        <field
            name="description"
        >Son donemde kazanilan musteri sayilari ve onceki donemle karsilastirma, en iyi musteriler listesi. NOT: VIP/Yeni/Risk altinda tile'lari su an ayni sayiyi gosteriyor — gercek RFM/CLV segmentasyonu henuz gelistirme bekliyor.</field>
        <field name="module_name">spreadsheet_customer_segmentation_oca</field>
        <field name="duration_minutes">4</field>
        <field name="difficulty">intermediate</field>
        <field name="tags">dashboard,customer,segmentation</field>
    </record>

    <record id="tutorial_campaign_roi" model="spreadsheet.tutorial">
        <field name="name">📣 E-posta kampanya performansi</field>
        <field name="sequence">220</field>
        <field
            name="description"
        >Tamamlanan e-posta kampanyalarinin gonderilen/iletilen/acilan/tiklanan sayilari ve aylik iletim trendi. NOT: isim 'ROI' olsa da su an gercek ciro/kupon atifi yok — sadece e-posta etkilesimini olcer.</field>
        <field name="module_name">spreadsheet_campaign_roi_oca</field>
        <field name="duration_minutes">3</field>
        <field name="difficulty">beginner</field>
        <field name="tags">dashboard,marketing,campaign,mailing</field>
    </record>

    <record id="tutorial_loyalty_dashboard" model="spreadsheet.tutorial">
        <field name="name">🎁 Sadakat programi dashboard'u</field>
        <field name="sequence">230</field>
        <field
            name="description"
        >Sadakat programi analizi: puan, kupon ve uye metrikleri. Yalnizca Odoo Loyalty modulu aktif kullaniliyorsa anlamli.</field>
        <field name="module_name">spreadsheet_loyalty_dashboard_oca</field>
        <field name="duration_minutes">3</field>
        <field name="difficulty">beginner</field>
        <field name="tags">dashboard,loyalty</field>
    </record>

    <record id="tutorial_pdf_report" model="spreadsheet.tutorial">
        <field name="name">📄 Profesyonel PDF export</field>
        <field name="sequence">240</field>
        <field
            name="description"
        >Bir spreadsheet'i sirket logolu, profesyonel bir PDF olarak disa aktarin — musteri veya yonetim sunumlari icin.</field>
        <field name="module_name">spreadsheet_pdf_report_oca</field>
        <field name="duration_minutes">3</field>
        <field name="difficulty">beginner</field>
        <field name="tags">pdf,export,report</field>
    </record>

    <record id="tutorial_record_rule" model="spreadsheet.tutorial">
        <field name="name">🔒 Dashboard'a kullanici bazli kayit kurallari</field>
        <field name="sequence">250</field>
        <field
            name="description"
        >Dashboard verisine kullanici bazli kayit kurallari (record rule) uygulayin — her kullanici yalnizca kendi verisini gorsun. Ozellikle bayi izolasyonu (her bayi kendi siparislerini) icin.</field>
        <field name="module_name">spreadsheet_record_rule_oca</field>
        <field name="duration_minutes">5</field>
        <field name="difficulty">advanced</field>
        <field name="tags">security,record_rule,dashboard,dealer</field>
    </record>

    <record id="tutorial_scheduled_refresh" model="spreadsheet.tutorial">
        <field name="name">🔄 Zamanli veri yenileme</field>
        <field name="sequence">260</field>
        <field
            name="description"
        >Spreadsheet revizyonunu periyodik olarak artirarak dashboard verilerini otomatik tazeleyin (cron ile) — acilista her zaman guncel veri.</field>
        <field name="module_name">spreadsheet_scheduled_refresh_oca</field>
        <field name="duration_minutes">2</field>
        <field name="difficulty">beginner</field>
        <field name="tags">refresh,cron,scheduled</field>
    </record>
</odoo>
