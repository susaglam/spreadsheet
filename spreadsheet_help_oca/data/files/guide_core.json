      "cells": {
        "A1": "🧰 ODOO CORE FORMULLERI — Referans ve Canli Ornekler",
        "A2": "Bu sayfadaki formuller CANLI calisir. Kopyalayip kendi sayfanda kullanabilirsin.",
        "A4": "MUHASEBE (spreadsheet_account)",
        "A5": "Formul",
        "B5": "Aciklama  (DIKKAT: tarih araligi ZORUNLU arguman)",
        "A6": "=ODOO.BALANCE(\"600\", \"2026\")",
        "B6": "600 ile baslayan hesaplarin 2026 mali yili net bakiyesi (borc - alacak)",
        "A7": "=ODOO.CREDIT(\"600\", \"2026\")",
        "B7": "600 hesaplarinin 2026 alacak toplami",
        "A8": "=ODOO.DEBIT(\"600\", \"2026\")",
        "B8": "600 hesaplarinin 2026 borc toplami",
        "A9": "=ODOO.RESIDUAL(\"400\")",
        "B9": "400 ile baslayan hesaplarda acik (odenmemis) kalan tutar",
        "A10": "=ODOO.PARTNER.BALANCE(\"1\")",
        "B10": "1 numarali partnerin acik bakiyesi",
        "A11": "=ODOO.FISCALYEAR.START(TODAY())",
        "B11": "Bugunun icinde oldugu mali yilin baslangic tarihi",
        "A12": "=ODOO.FISCALYEAR.END(TODAY())",
        "B12": "Bugunun icinde oldugu mali yilin bitis tarihi",
        "A13": "NOT: Muhasebe hareketi yoksa bakiyeler 0,00 doner — formul dogru, veri henuz yok.",
        "A15": "CANLI VERI KAYNAKLARI (res.partner uzerinden)",
        "A16": "=PIVOT.VALUE(1, \"__count\")",
        "B16": "Pivot 1: toplam partner sayisi (canli)",
        "A17": "=ODOO.LIST.VALUE(1, 1, \"name\")",
        "B17": "List 1: 1. partnerin adi (canli)",
        "A18": "=ODOO.LIST.VALUE(1, 2, \"name\")",
        "B18": "List 1: 2. partnerin adi (canli)",
        "A19": "=ODOO.CURRENCY.RATE(\"USD\", \"EUR\")",
        "B19": "USD to EUR guncel doviz kuru",
        "A21": "BIZIM CUSTOM FORMULLER (OCA modulleri)",
        "A22": "Modul",
        "B22": "Formuller",
        "A23": "forecast_oca",
        "B23": "ODOO.FORECAST, ODOO.TREND, ODOO.MOVING_AVG",
        "A24": "period_comparison_oca",
        "B24": "ODOO.PERCENT_CHANGE, ODOO.GROWTH_ARROW, ODOO.YOY, ODOO.VARIANCE",
        "A26": "🔗 DAHA FAZLA ORNEK ICIN BU REHBERLERI AC",
        "A27": "• 📈 Rehber: Tahminleme Fonksiyonlari (forecast)",
        "A28": "• 📊 Rehber: Donem Karsilastirma (period comparison)",
        "A29": "• ✨ Rehber: Ozellikler ve Menuler"
