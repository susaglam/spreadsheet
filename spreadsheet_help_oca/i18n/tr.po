#: model_terms:ir.ui.view,arch_db:spreadsheet_help_oca.sample_data_loader_view_form
msgid ""
"Adds demo records to the spreadsheet modules you select. Every record name "
"starts with \"SAMPLE\", so you can find and delete them later."
msgstr ""
"Seçtiğiniz hesap tablosu modüllerine demo kayıtları ekler. Her kaydın adı "
"\"SAMPLE\" ile başlar; böylece daha sonra bulup silebilirsiniz."

#. module: spreadsheet_help_oca
#: model:ir.model.fields.selection,name:spreadsheet_help_oca.selection__spreadsheet_tutorial__difficulty__advanced
