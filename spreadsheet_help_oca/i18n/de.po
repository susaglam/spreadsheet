#. module: spreadsheet_help_oca
#. odoo-python
#: code:addons/spreadsheet_help_oca/wizards/sample_data_loader.py:0
msgid ""
"Loaded: %(loaded)s. Not loaded: %(failed)s. These examples were skipped and "
"nothing else was changed. The server log has the technical details: fix the "
"problem (for example a missing access right or required setting) and run the"
" loader again."
msgstr ""
"Geladen: %(loaded)s. Nicht geladen: %(failed)s. Diese Beispiele wurden "
"übersprungen und sonst wurde nichts geändert. Das Serverprotokoll enthält "
"die technischen Details: Beheben Sie das Problem (zum Beispiel ein fehlendes"
" Zugriffsrecht oder eine fehlende Pflichteinstellung) und starten Sie den "
"Import erneut."

#. module: spreadsheet_help_oca
#: model:ir.model.fields,help:spreadsheet_help_oca.field_spreadsheet_tutorial__sequence
msgid "Lower numbers are shown first in the Tutorials & Videos list."
msgstr ""
"Niedrigere Nummern werden in der Liste Tutorials & Videos zuerst angezeigt."

#. module: spreadsheet_help_oca
#: model:spreadsheet.tutorial,description:spreadsheet_help_oca.tutorial_loyalty_dashboard
msgid ""
"Loyalty program analysis: points, coupon and member metrics. Only meaningful"
" when the Odoo Loyalty app is actively used."
msgstr ""
"Analyse des Treueprogramms: Kennzahlen zu Punkten, Gutscheinen und "
"Mitgliedern. Nur sinnvoll, wenn die Odoo-App Kundenbindung aktiv genutzt "
"wird."

