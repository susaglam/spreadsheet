<odoo>
    <!-- Adds a block to the single "Spreadsheet" settings app owned by
         spreadsheet_oca. Never declare a second <app name="spreadsheet_oca">:
         saas-19.4 would list "Spreadsheet" twice in the Settings navigation.
         notApp="0" un-hides the app, which spreadsheet_oca ships hidden until
         an add-on gives it content. -->
    <record id="res_config_settings_view_form_spreadsheet_api" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.spreadsheet.api</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="101" />
        <field name="inherit_id" ref="spreadsheet_oca.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='spreadsheet_oca']" position="attributes">
                <attribute name="notApp">0</attribute>
            </xpath>
            <xpath expr="//app[@name='spreadsheet_oca']" position="inside">
                <block title="REST API" name="api_settings_block">
                    <setting help="Default rate limit for new API tokens.">
                        <field name="api_default_rate_limit" />
                    </setting>
                    <setting help="Max webhook delivery attempts before giving up.">
                        <field name="api_webhook_retry_max" />
                    </setting>
                    <setting help="Default expiry for new API tokens (0 = no expiry).">
                        <field name="api_token_default_expiry_days" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
