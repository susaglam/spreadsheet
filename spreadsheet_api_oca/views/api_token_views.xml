<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="api_token_view_list" model="ir.ui.view">
        <field name="name">spreadsheet.api.token.list</field>
        <field name="model">spreadsheet.api.token</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="token_hint" />
                <field name="user_id" />
                <field name="last_used" />
                <field name="usage_count" />
                <field name="expires_at" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="api_token_view_form" model="ir.ui.view">
        <field name="name">spreadsheet.api.token.form</field>
        <field name="model">spreadsheet.api.token</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_generate_token"
                        type="object"
                        string="Generate Token"
                        class="btn-primary"
                        icon="fa-key"
                        invisible="token_hint"
                    />
                    <button
                        name="action_generate_token"
                        type="object"
                        string="Regenerate Token"
                        class="btn-warning"
                        icon="fa-refresh"
                        invisible="not token_hint"
                        confirm="Regenerating invalidates the current token immediately: every integration using it stops working until you give it the new one. Continue?"
                    />
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="token_hint">
                        This token has no secret yet. Click
                        <strong>Generate Token</strong>
                        to create one. The secret is shown only once, so copy it into your integration right away. Only a fingerprint of it is stored.
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="user_id"
                                groups="spreadsheet_oca.group_manager"
                            />
                            <!-- Non-managers can only use themselves: don't offer a choice that fails on save. -->
                            <field
                                name="user_id"
                                groups="!spreadsheet_oca.group_manager"
                                readonly="1"
                            />
                            <field name="expires_at" />
                            <field name="active" />
                        </group>
                        <group>
                            <field name="token_hint" />
                            <field name="last_used" />
                            <field name="usage_count" />
                        </group>
                    </group>
                    <group
                        string="Allowed Spreadsheets"
                        help="Leave empty to grant access to all spreadsheets the user can read."
                    >
                        <field
                            name="spreadsheet_ids"
                            widget="many2many_tags"
                            nolabel="1"
                        />
                    </group>
                    <notebook>
                        <page string="Rate Limiting &amp; Webhook" name="advanced">
                            <group>
                                <group string="Rate Limiting">
                                    <field name="rate_limit_per_minute" />
                                    <field name="rate_limit_exceeded_count" />
                                </group>
                                <group string="Webhook">
                                    <field
                                        name="webhook_url"
                                        placeholder="https://example.com/hook"
                                    />
                                </group>
                            </group>
                            <separator string="Webhook Delivery Log" />
                            <field name="webhook_event_ids" readonly="1">
                                <list>
                                    <field name="create_date" />
                                    <field name="event_type" />
                                    <field name="spreadsheet_id" />
                                    <field name="response_status" />
                                    <field name="retry_count" />
                                    <field name="delivered" widget="boolean_toggle" />
                                </list>
                            </field>
                        </page>
                        <page string="API Usage" name="usage">
                            <div>
                                <p>
                                    <strong>Example API calls:</strong>
                                </p>
                                <pre>GET /api/spreadsheet/list
  Authorization: Bearer YOUR_TOKEN

GET /api/spreadsheet/&lt;id&gt;
  Authorization: Bearer YOUR_TOKEN

GET /api/spreadsheet/&lt;id&gt;/cells?sheet=Dashboard
  Authorization: Bearer YOUR_TOKEN</pre>
                                <p>
                                    Always send the token in the
                                    <code>Authorization</code>
                                    header. A
                                    <code>?token=</code>
                                    query parameter is refused by default because URLs end up in server and proxy logs.
                                </p>
                                <p>
                                    <strong>Webhook payload format:</strong>
                                </p>
                                <pre>{
  "event": "update",
  "spreadsheet_id": 1,
  "spreadsheet_name": "Sales Q1",
  "timestamp": "2026-01-15T10:30:00"
}</pre>
                                <p>
                                    <strong>Verifying a webhook call:</strong>
                                </p>
                                <p>
                                    Each call carries the headers X-Spreadsheet-Event, X-Spreadsheet-Token-Id and X-Spreadsheet-Signature. The signature is "sha256=" followed by the HMAC-SHA256 of the raw request body, using the SHA-256 hex digest of your token as key. Redirects are not followed, and events are only sent for spreadsheets the token user can read.
                                </p>
                                <pre>key = sha256(TOKEN).hexdigest()
expected = "sha256=" + hmac_sha256(key, raw_body).hexdigest()</pre>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="api_token_show_view_form" model="ir.ui.view">
        <field name="name">spreadsheet.api.token.show.form</field>
        <field name="model">spreadsheet.api.token.show</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h3 class="fw-bold">
                        Copy your API token now
                    </h3>
                    <group>
                        <field name="token_name" readonly="1" />
                    </group>
                    <p>
                        Configure your integration to send this secret in the HTTP header
                        <code>Authorization: Bearer &lt;token&gt;</code>
                    </p>
                    <field
                        name="token"
                        widget="CopyClipboardChar"
                        readonly="1"
                        class="mb-3"
                    />
                    <p class="alert alert-warning" role="alert">
                        <strong>Important:</strong>
                        the token cannot be displayed again, because only its fingerprint is stored. Anyone holding it can read the spreadsheets of the token user, so store it like a password.
                    </p>
                    <footer>
                        <button special="cancel" data-hotkey="x" string="Done" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="api_token_act_window" model="ir.actions.act_window">
        <field name="name">API Tokens</field>
        <field name="res_model">spreadsheet.api.token</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first API token</p>
            <p>
                A token lets an external tool call the spreadsheet REST API.
                Create one, click Generate Token and copy the secret, then call
                <code>/api/spreadsheet/list</code> with an
                <code>Authorization: Bearer &lt;token&gt;</code> header.
            </p>
        </field>
    </record>

    <record id="menu_api_tokens" model="ir.ui.menu">
        <field name="name">API Tokens</field>
        <field
            name="parent_id"
            ref="spreadsheet_oca.spreadsheet_spreadsheet_configuration_menu"
        />
        <field name="action" ref="api_token_act_window" />
        <field name="group_ids" eval="[(4, ref('spreadsheet_oca.group_user'))]" />
        <field name="sequence" eval="50" />
    </record>
</odoo>
