msgid "ID"
msgstr "ID"

#. module: spreadsheet_api_oca
#: model:ir.model.fields,help:spreadsheet_api_oca.field_spreadsheet_api_token__webhook_url
msgid ""
"If set, this URL is called (POST) when a spreadsheet this token can read is "
"created, changed or deleted. Only public http(s) endpoints are accepted; "
"redirects are not followed. Each call carries an X-Spreadsheet-Signature "
"header (HMAC-SHA256 of the body) so the receiver can check it really comes "
"from this server."
msgstr ""
"Wenn gesetzt, wird diese URL aufgerufen (POST), sobald ein Spreadsheet, das "
"dieses Token lesen darf, erstellt, geändert oder gelöscht wird. Nur "
"öffentliche http(s)-Endpunkte werden akzeptiert; Weiterleitungen werden "
"nicht verfolgt. Jeder Aufruf enthält einen X-Spreadsheet-Signature-Header "
"(HMAC-SHA256 des Bodys), damit der Empfänger prüfen kann, dass er wirklich "
"von diesem Server stammt."

#. module: spreadsheet_api_oca
#: model_terms:ir.ui.view,arch_db:spreadsheet_api_oca.api_token_view_form
msgid ""
"key = sha256(TOKEN).hexdigest()\n"
"expected = \"sha256=\" + hmac_sha256(key, raw_body).hexdigest()"
msgstr ""
"key = sha256(TOKEN).hexdigest()\n"
"expected = \"sha256=\" + hmac_sha256(key, raw_body).hexdigest()"

