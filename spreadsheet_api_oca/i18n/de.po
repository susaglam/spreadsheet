"}"
msgstr ""
"{\n"
"  \"event\": \"update\",\n"
"  \"spreadsheet_id\": 1,\n"
"  \"spreadsheet_name\": \"Sales Q1\",\n"
"  \"timestamp\": \"2026-01-15T10:30:00\"\n"
"}"
