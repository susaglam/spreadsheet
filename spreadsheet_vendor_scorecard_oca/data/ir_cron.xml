<!-- noupdate: an admin may change the schedule, the run user or deactivate the
     job; a module upgrade must keep those changes. The xmlid is unchanged from
     the former views file, so upgraded databases keep their single cron. -->
<odoo noupdate="1">
    <record id="ir_cron_vendor_scorecard" model="ir.cron">
        <field name="name">Spreadsheet: Compute Vendor Scorecards</field>
        <field name="model_id" ref="model_spreadsheet_vendor_scorecard" />
        <field name="state">code</field>
        <field name="code">model._cron_compute_scorecards()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
    </record>
</odoo>
