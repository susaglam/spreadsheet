<odoo noupdate="1">
    <!--
        noupdate="1": edits here are NOT applied to databases where the module is
        already installed. migrations/saas~19.4.1.0.2/post-migrate.py brings
        existing databases in line with this version of the template.
    -->
    <record id="contract_expiry_email_template" model="mail.template">
        <field name="name">Contract Expiry Reminder</field>
        <field name="model_id" ref="model_spreadsheet_contract" />
        <field name="subject">Contract Expiring: {{ object.name }}</field>
        <field
            name="email_from"
        >{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <!-- Internal reminder: address the responsible user only. With the
                 default recipients (use_default_to) the email would go to the
                 contract partner, i.e. the customer or vendor. -->
        <field name="use_default_to" eval="False" />
        <field name="partner_to">{{ object.responsible_id.partner_id.id or '' }}</field>
        <field name="lang">{{ object.responsible_id.lang }}</field>
        <!-- body_html is rendered with QWeb: dynamic values must use t-out.
                 {{ }} is only interpolated inside t-attf-* attributes. -->
        <field name="body_html" type="html">
            <div
                style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;"
            >
                <div
                    style="background-color: #e67e22; color: white; padding: 16px 24px;"
                >
                    <h2 style="margin: 0;">Contract Expiry Reminder</h2>
                </div>
                <div style="padding: 24px; border: 1px solid #ddd; border-top: none;">
                    <p>Hello <t t-out="object.responsible_id.name or ''" />,</p>
                    <p>The following contract is expiring soon:</p>
                    <table
                        style="width: 100%; border-collapse: collapse; margin: 16px 0;"
                    >
                        <tr>
                            <td style="padding: 8px; border-bottom: 1px solid #eee;">
                                <strong>Contract</strong>
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid #eee;">
                                <t t-out="object.name or ''" />
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border-bottom: 1px solid #eee;">
                                <strong>Partner</strong>
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid #eee;">
                                <t t-out="object.partner_id.name or ''" />
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border-bottom: 1px solid #eee;">
                                <strong>Expiry Date</strong>
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid #eee;">
                                <strong style="color: #e67e22;">
                                    <t t-out="format_date(object.date_end) or ''" />
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border-bottom: 1px solid #eee;">
                                <strong>Days Remaining</strong>
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid #eee;">
                    <t t-out="object.days_to_expiry" /> days
                </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border-bottom: 1px solid #eee;">
                                <strong>Value</strong>
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid #eee;">
                                <t
                                    t-if="object.currency_id"
                                    t-out="format_amount(object.amount, object.currency_id) or ''"
                                />
                                <t t-else="" t-out="object.amount" />
                            </td>
                        </tr>
                    </table>
                    <p>Please review and take appropriate action for renewal.</p>
                </div>
            </div>
        </field>
    </record>
</odoo>
