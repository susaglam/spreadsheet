<odoo>
    <!-- Search -->
    <record id="contract_view_search" model="ir.ui.view">
        <field name="name">spreadsheet.contract.search</field>
        <field name="model">spreadsheet.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="partner_id" />
                <field name="responsible_id" />
                <filter
                    name="active_contracts"
                    string="Active"
                    domain="[('state', '=', 'active')]"
                />
                <filter
                    name="expiring"
                    string="Expiring Soon"
                    domain="[('state', '=', 'expiring')]"
                />
                <filter
                    name="expired"
                    string="Expired"
                    domain="[('state', '=', 'expired')]"
                />
                <group>
                    <filter
                        name="group_by_type"
                        string="Type"
                        context="{'group_by': 'contract_type'}"
                    />
                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_by_partner"
                        string="Partner"
                        context="{'group_by': 'partner_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- List -->
    <record id="contract_view_list" model="ir.ui.view">
        <field name="name">spreadsheet.contract.list</field>
        <field name="model">spreadsheet.contract</field>
        <field name="arch" type="xml">
            <list
                decoration-danger="state == 'expired'"
                decoration-warning="state == 'expiring'"
                decoration-success="state == 'active'"
            >
                <field name="name" />
                <field name="partner_id" />
                <field name="contract_type" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="days_to_expiry" string="Days Left" />
                <field name="amount" />
                <field name="responsible_id" widget="many2one_avatar_user" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'active'"
                    decoration-warning="state == 'expiring'"
                    decoration-danger="state == 'expired'"
                    decoration-info="state == 'renewed'"
                />
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="contract_view_form" model="ir.ui.view">
        <field name="name">spreadsheet.contract.form</field>
        <field name="model">spreadsheet.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_renew"
                        type="object"
                        string="Renew Contract"
                        class="btn-primary"
                        icon="fa-refresh"
                        invisible="state not in ('expiring', 'expired')"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,active,expiring,expired"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Contract Details">
                            <field name="partner_id" />
                            <field name="contract_type" />
                            <field name="responsible_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group string="Dates &amp; Value">
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="renewal_reminder_days" />
                            <field name="days_to_expiry" />
                            <label for="amount" />
                            <div class="o_row">
                                <field name="amount" />
                                <field name="currency_id" />
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="SLA Metrics" name="sla">
                            <field name="sla_ids">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="target_value" />
                                    <field name="actual_value" />
                                    <field name="unit" />
                                    <field
                                        name="compliance"
                                        widget="badge"
                                        decoration-success="compliance == 'met'"
                                        decoration-danger="compliance == 'breached'"
                                        decoration-info="compliance == 'pending'"
                                    />
                                    <field name="last_updated" />
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Calendar -->
    <record id="contract_view_calendar" model="ir.ui.view">
        <field name="name">spreadsheet.contract.calendar</field>
        <field name="model">spreadsheet.contract</field>
        <field name="arch" type="xml">
            <calendar
                date_start="date_start"
                date_stop="date_end"
                color="contract_type"
                mode="month"
            >
                <field name="name" />
                <field name="partner_id" />
                <field name="state" />
            </calendar>
        </field>
    </record>

    <!-- Action -->
    <record id="contract_act_window" model="ir.actions.act_window">
        <field name="name">Contracts &amp; SLA</field>
        <field name="res_model">spreadsheet.contract</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{'search_default_active_contracts': 1}</field>
    </record>

    <!-- Menu under Spreadsheets -->
    <record id="menu_contracts" model="ir.ui.menu">
        <field name="name">Contracts &amp; SLA</field>
        <field name="parent_id" ref="spreadsheet_oca.spreadsheet_spreadsheet_menu" />
        <field name="action" ref="contract_act_window" />
        <field name="group_ids" eval="[(4, ref('spreadsheet_oca.group_user'))]" />
        <field name="sequence" eval="25" />
    </record>
</odoo>
