<odoo>
    <record id="res_config_settings_view_form_spreadsheet_contract" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.spreadsheet.contract</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="102" />
        <field
            name="inherit_id"
            ref="spreadsheet_kpi_alert_oca.res_config_settings_view_form_spreadsheet_kpi"
        />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='spreadsheet_oca']" position="inside">
                <block title="Contracts &amp; SLA" name="contract_settings_block">
                    <setting
                        help="Default days before expiry to trigger renewal reminder."
                    >
                        <field name="contract_default_reminder_days" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
