#. module: spreadsheet_contract_sla_oca
#: model:mail.template,body_html:spreadsheet_contract_sla_oca.contract_expiry_email_template
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"    <div style=\"background-color: #e67e22; color: white; padding: 16px 24px;\">\n"
"        <h2 style=\"margin: 0;\">Contract Expiry Reminder</h2>\n"
"    </div>\n"
"    <div style=\"padding: 24px; border: 1px solid #ddd; border-top: none;\">\n"
"        <p>Hello <t t-out=\"object.responsible_id.name or ''\"/>,</p>\n"
"        <p>The following contract is expiring soon:</p>\n"
"        <table style=\"width: 100%; border-collapse: collapse; margin: 16px 0;\">\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n"
"                    <strong>Contract</strong>\n"
"                </td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n"
"                    <t t-out=\"object.name or ''\"/>\n"
"                </td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n"
"                    <strong>Partner</strong>\n"
"                </td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n"
"                    <t t-out=\"object.partner_id.name or ''\"/>\n"
"                </td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n"
"                    <strong>Expiry Date</strong>\n"
"                </td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n"
"                    <strong style=\"color: #e67e22;\">\n"
"                        <t t-out=\"format_date(object.date_end) or ''\"/>\n"
"                    </strong>\n"
"                </td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n"
"                    <strong>Days Remaining</strong>\n"
"                </td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n"
"                    <t t-out=\"object.days_to_expiry\"/> days\n"
"                </td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n"
"                    <strong>Value</strong>\n"
"                </td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n"
"                    <t t-if=\"object.currency_id\" t-out=\"format_amount(object.amount, object.currency_id) or ''\"/>\n"
"                    <t t-else=\"\" t-out=\"object.amount\"/>\n"
"                </td>\n"
"            </tr>\n"
"        </table>\n"
"        <p>Please review and take appropriate action for renewal.</p>\n"
"    </div>\n"
"</div>\n"
"            "
msgstr ""

