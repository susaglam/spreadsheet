<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="spreadsheet_oca.SpreadsheetFileUploader" owl="1">
        <div
            t-att-class="this.props.record and this.props.record.data ? 'oe_kanban_color_' + this.props.record.data.color : ''"
        >
            <FileUploader
                acceptedFileExtensions="this.props.acceptedFileExtensions"
                fileUploadClass="'spreadsheet_file_uploader'"
                multiUpload="true"
                onUploaded.bind="this.onFileUploaded"
                onUploadComplete.bind="this.onUploadComplete"
            >
                <t t-set-slot="toggler">
                    <t
                        t-if="this.props.togglerTemplate"
                        t-call="{{ this.props.togglerTemplate }}"
                    />
                    <t t-else="" t-slot="toggler" />
                </t>
                <t t-slot="extra" />
            </FileUploader>
        </div>
    </t>
    <t
        t-name="spreadsheet_oca.ListView.Buttons"
        t-inherit="web.ListView.Buttons"
        t-inherit-mode="primary"
    >
        <!-- saas-19.2: web.ListView.Buttons templatesi artik bir <div class="o_list_buttons"> wrapper'i yok.
             Butonlar direkt root level. 'o_list_button_add' butonunun yanina Upload butonunu ekliyoruz. -->
        <xpath expr="//button[hasclass('o_list_button_add')]" position="after">
            <SpreadsheetFileUploader>
                <t t-set-slot="toggler">
                    <button
                        type="button"
                        class="btn btn-secondary o_button_upload_spreadsheet"
                    >
                        Upload
                    </button>
                </t>
            </SpreadsheetFileUploader>
        </xpath>
    </t>
</templates>
