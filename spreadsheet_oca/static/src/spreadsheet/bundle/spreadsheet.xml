<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="spreadsheet_oca.ActionSpreadsheetOca" owl="1">
        <div class="o_spreadsheet_oca_container">
            <SpreadsheetControlPanel />
            <SpreadsheetRenderer
                record="this.record"
                res_id="this.spreadsheetId"
                model="this.model"
                importData="this.importData"
            />
        </div>
    </t>
    <t t-name="spreadsheet_oca.PivotPanel" owl="1">
        <t t-if="this.pivotId">
            <PivotPanelDisplay pivotId="this.pivotId" />
        </t>
        <t t-else="1" />
    </t>
    <t t-name="spreadsheet_oca.PivotPanelDisplay" owl="1">
        <div
            class="h-100 position-relative overflow-x-hidden overflow-y-auto"
            t-custom-ref="pivotPanel"
        >
            <PivotTitleSectionInsertion
                pivotId="this.props.pivotId"
                flipAxis.bind="this.flipAxis"
            />
            <t t-set="definition" t-value="this.store.definition" />
            <div class="o-section">
                <div class="o-section-title">Model</div>
                <div class="o_model_name"><t t-out="this.modelLabel" /> (<t
                    t-out="definition.model"
                />)</div>
            </div>
            <div class="o-section">
                <div class="o-section-title">Domain</div>
                <DomainSelector
                    resModel="definition.model"
                    domain="this.domain"
                    t-key="'pivot_' + this.props.pivotId"
                />
                <div class="btn btn-link" t-on-click="this.editDomain">
                    Edit domain
                </div>
            </div>
            <PivotLayoutConfiguratorWithAggregators
                unusedGroupableFields="this.store.unusedGroupableFields"
                measureFields="this.store.measureFields"
                unusedGranularities="this.store.unusedGranularities"
                dateGranularities="this.store.dateGranularities"
                datetimeGranularities="this.store.datetimeGranularities"
                definition="definition"
                onDimensionsUpdated.bind="this.updateDimensions"
                onFiltersUpdated.bind="this.updateDimensions"
                getScrollableContainerEl.bind="this.getScrollableContainerEl"
                pivotId="this.props.pivotId"
            />
            <div class="o-section o_spreadsheet_oca_pivot_panel_info">
                Last updated at <t t-out="this.lastUpdate" />
            </div>
        </div>
    </t>

    <t t-name="spreadsheet_oca.ListPanel" owl="1">
        <t t-if="this.listId">
            <ListPanelDisplay
                listId="this.listId"
                listDefinition="this.listDefinition"
            />
        </t>
        <t t-else="1" />
    </t>
    <t t-name="spreadsheet_oca.ListPanelDisplay" owl="1">
        <div class="o_spreadsheet_oca_datasource_panel">
            <div class="o_spreadsheet_oca_datasource_panel_field">
                <div
                    class="o_spreadsheet_oca_datasource_panel_field_title"
                >List name</div>
                <span
                    t-out="this.env.model.getters.getListDisplayName(this.props.listId)"
                />
            </div>
            <div class="o_spreadsheet_oca_datasource_panel_field">
                <div class="o_spreadsheet_oca_datasource_panel_field_title">Model</div>
                <div><t t-out="this.modelLabel" /> (<t
                    t-out="this.props.listDefinition.model"
                />)</div>
            </div>
            <div class="o_spreadsheet_oca_datasource_panel_field">
                <div class="o_spreadsheet_oca_datasource_panel_field_title">Domain</div>
                <DomainSelector
                    resModel="this.props.listDefinition.model"
                    domain="this.domain"
                    t-key="'list_' + this.props.listId"
                />
                <div class="btn btn-link" t-on-click="this.editDomain">
                    Edit domain
                </div>
            </div>
            <div class="o_spreadsheet_oca_datasource_panel_field o-sidePanelButtons">
                <button
                    t-on-click="this.insertList"
                    class="btn btn-success"
                >Insert list</button>
                <button
                    t-on-click="() => this.delete()"
                    class="btn btn-danger"
                >Delete</button>
            </div>
            <div
                class="o_spreadsheet_oca_datasource_panel_field o-sidePanelButtons mt-2 mb-2"
            >
                <label for="list_rows">Rows:</label>
                <input
                    type="number"
                    class="o_input"
                    t-custom-model="this.state.listRows"
                    id="list_rows"
                    min="1"
                    title="Total rows used when inserting list"
                />
            </div>
            <div class="o_spreadsheet_oca_pivot_panel_info">
                Last updated at <t t-out="this.lastUpdate" />
            </div>
        </div>
    </t>
    <t t-name="spreadsheet_oca.FilterPanel" owl="1">
        <div
            t-foreach="this.env.model.getters.getGlobalFilters()"
            t-as="filter"
            t-key="filter.id"
            class="o_spreadsheet_oca_filter"
            t-att-data-filter-type="filter.type"
        >
            <div class="spreadsheet_oca_filter_label">
                <span t-out="filter.label" />
            </div>
            <div class="spreadsheet_oca_filter_value">
                <FilterValue
                    filter="filter"
                    model="this.env.model"
                    globalFilterValue="this.getGlobalFilterValue(filter.id)"
                    setGlobalFilterValue="(id, value) => this.setGlobalFilterValue(filter.id, value)"
                    showClear="true"
                />
                <i
                    class="fa fa-cog btn btn-link text-muted spreadsheet_oca_filter_value_edit"
                    title="Edit filter"
                    t-on-click="() =&gt; this.onEditFilter(filter)"
                />
            </div>
        </div>
        <div class="o-sidePanelButtons">
            <button
                t-on-click="() => this.onAddFilter('date')"
                class="btn o_spreadsheet_oca_add_date_filter"
            >Add date</button>
            <button
                t-on-click="() => this.onAddFilter('relation')"
                class="btn o_spreadsheet_oca_add_relation_filter"
            >Add relation</button>
            <button
                t-on-click="() => this.onAddFilter('text')"
                class="btn o_spreadsheet_oca_add_text_filter"
            >Add text</button>
        </div>
    </t>
    <t t-name="spreadsheet_oca.EditFilterPanel" owl="1">
        <div class="o_spreadsheet_oca_filter">
            <div class="spreadsheet_oca_filter_label">
                <span>Label</span>
            </div>
            <div class="spreadsheet_oca_filter_value">
                <input
                    type="text"
                    t-custom-model="this.state.label"
                    class="o_input o_global_filter_label"
                />
            </div>
        </div>
        <div
            class="o_spreadsheet_oca_filter o_spreadsheet_oca_filter_default_date"
            t-if="this.state.type === 'date'"
        >
            <div class="spreadsheet_oca_filter_label">Default value</div>
            <div class="spreadsheet_oca_filter_value">
                <DefaultDateValue
                    value="this.dateDefaultValue"
                    update="(value) => this.onDateDefaultValueChanged(value)"
                />
            </div>
        </div>
        <div
            class="o_spreadsheet_oca_filter o_spreadsheet_oca_filter_default_text"
            t-if="this.state.type === 'text'"
        >
            <div class="spreadsheet_oca_filter_label">Default value</div>
            <div class="spreadsheet_oca_filter_value">
                <div class="w-100">
                    <TextFilterValue
                        value="this.textDefaultStrings"
                        options="[]"
                        onValueChanged="(strings) => this.onTextDefaultValueChanged(strings)"
                        placeholder.translate="Type a value and press Enter"
                    />
                </div>
            </div>
        </div>
        <t t-if="this.state.type === 'relation'">
            <div class="o_spreadsheet_oca_filter">
                <div class="spreadsheet_oca_filter_label">Related model</div>
                <div class="spreadsheet_oca_filter_value">
                    <ModelSelector
                        value="this.state.modelData.label or ''"
                        models="this.models"
                        onModelSelected.bind="this.onModelSelected"
                    />
                </div>
                <Checkbox
                    t-if="this.state.modelData.hasParentRelation"
                    name="'includeChildren'"
                    label.translate="Include children"
                    value="this.state.includeChildren"
                    onChange="(value) => this.state.includeChildren = value"
                />
            </div>
            <t t-if="this.state.modelData.technical">
                <div
                    class="o_spreadsheet_oca_filter o_spreadsheet_oca_filter_default_relation"
                >
                    <div class="spreadsheet_oca_filter_label">Default value</div>
                    <div
                        class="spreadsheet_oca_filter_value"
                        t-if="!this.isCurrentUserDefault"
                    >
                        <MultiRecordSelector
                            resModel="this.state.modelData.technical"
                            resIds="this.relationDefaultIds"
                            t-key="this.state.modelData.technical"
                            placeholder="''"
                            domain="this.getCorrectDomain()"
                            update.bind="this.onRecordsSelected"
                        />
                    </div>
                    <div
                        class="spreadsheet_oca_filter_value"
                        t-if="this.state.modelData.technical === 'res.users'"
                    >
                        <Checkbox
                            className="'mb-1'"
                            label.translate="Automatically filter on the current user"
                            onChange="(value) => this.onCurrentUserDefaultChanged(value)"
                            value="this.isCurrentUserDefault"
                        />
                    </div>
                </div>
                <div class="o_spreadsheet_oca_filter">
                    <div class="spreadsheet_oca_filter_label">Possible values</div>
                    <div class="spreadsheet_oca_filter_value">
                        <Checkbox
                            className="'mb-1'"
                            label.translate="Restrict values with a domain"
                            onChange.bind="this.changeDomainRestriction"
                            value="this.state.valuesRestricted"
                        />
                    </div>
                    <t t-if="this.state.valuesRestricted">
                        <DomainSelector
                            resModel="this.state.modelData.technical"
                            domain="this.allowedValuesDomain"
                            t-key="'filter_' + this.filterId"
                        />
                        <div class="btn btn-link" t-on-click="this.editDomain">
                            Edit domain
                        </div>
                    </t>
                </div>
            </t>
        </t>
        <div
            class="o_spreadsheet_oca_filter o_spreadsheet_oca_filter_field_matching"
            t-foreach="Object.values(this.state.objects)"
            t-as="object"
            t-key="object.id"
            t-if="object.model"
            t-att-data-id="object.id"
        >
            <div class="spreadsheet_oca_filter_label">
                <span t-out="object.name" /> - <span t-out="object.tag" />
            </div>
            <div class="d-flex justify-content-between">
                <div class="spreadsheet_oca_filter_value flex-column flex-grow-1">
                    <ModelFieldSelector
                        path="this.getModelField(object.fieldMatch)"
                        resModel="object.model"
                        readonly="false"
                        allowEmpty="true"
                        isDebugMode="!!this.env.debug"
                        update="(path, fieldInfo) => this.onFieldMatchUpdate(object, path, fieldInfo)"
                        filter.bind="this.filterModelFieldSelectorField"
                        t-key="object.id"
                    />
                </div>
            </div>

            <div class="spreadsheet_oca_filter_value" t-if="this.state.type === 'date'">
                <select
                    t-on-change="(ev) => this.onChangeFieldMatchOffset(object, ev)"
                    class="o_input"
                >
                    <t t-foreach="this.dateOffset" t-as="offset" t-key="offset.value">
                        <option
                            t-att-selected="offset.value === (object.fieldMatch.offset || 0)"
                            t-att-value="offset.value"
                        >
                            <t t-out="offset.name" />
                        </option>
                    </t>
                </select>
            </div>
        </div>
        <div class="o-sidePanelButtons justify-content-center">
            <button
                t-if="this.filterId"
                t-on-click="this.onRemove"
                class="btn btn-danger"
            >Remove</button>
            <button t-on-click="this.onCancel" class="btn btn-warning">Cancel</button>
            <button
                t-on-click="this.onSave"
                class="btn btn-primary o_spreadsheet_oca_filter_save"
            >Save</button>
        </div>
    </t>
    <t t-name="spreadsheet_oca.SpreadsheetRenderer" owl="1">
        <SpreadsheetComponent model="this.spreadsheet_model" />
    </t>
    <t t-name="spreadsheet_oca.SpreadsheetName" owl="1">
        <input
            type="text"
            class="o_spreadsheet_oca_name"
            title="Change name"
            t-custom-ref="spreadsheetName"
            t-att-value="this.state.name"
            t-att-readonly="this.props.isReadonly"
            t-on-change="this._onNameChanged"
        />
        <i class="fa fa-exclamation-triangle text-danger" t-if="! this.state.name" />
        <span
            class="text-danger o_spreadsheet_oca_name_warning"
            t-if="! this.state.name"
        > name is required</span>
    </t>

    <!-- Derived from web.Breadcrumbs (saas-19.4). It is t-called from
         SpreadsheetControlPanel, so the entries come from this.breadcrumbs and
         the current (last) entry is the editable spreadsheet name. The
         breadcrumbs stay in this control panel on small screens as well (core
         moves them to the navbar there), and the collapsed dropdown is offered
         next to the back button so every parent page stays reachable. -->
    <t t-name="spreadsheet_oca.Breadcrumbs.Collapsed" owl="1">
        <Dropdown>
            <button class="btn btn-light btn-sm px-1 p-0">
                <i class="oi oi-ellipsis-h align-middle" />
            </button>
            <t t-set-slot="content">
                <t
                    t-foreach="collapsedBreadcrumbs"
                    t-as="breadcrumb"
                    t-key="breadcrumb.jsId"
                >
                    <DropdownItem
                        onSelected="breadcrumb.onSelected"
                        attrs="{ href: breadcrumb.url, 'data-tooltip': this.getBreadcrumbTooltip(breadcrumb) }"
                    >
                        <t t-call="web.Breadcrumb.Name" />
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>

    <t t-name="spreadsheet_oca.Breadcrumbs.Actions" owl="1">
        <div class="o_control_panel_breadcrumbs_actions d-inline-flex d-print-none">
            <t t-call-slot="control-panel-additional-actions" />
        </div>
    </t>

    <t t-name="spreadsheet_oca.Breadcrumbs" owl="1">
        <t t-set="previousBreadcrumb" t-value="this.breadcrumbs.at(-2)" />
        <t
            t-set="collapsedBreadcrumbs"
            t-value="this.breadcrumbs.slice(0, -2).reverse()"
        />

        <div
            t-if="previousBreadcrumb"
            class="o_breadcrumb d-flex flex-row align-self-stretch justify-content-between min-w-0"
        >
            <t t-if="this.env.isSmall">
                <button
                    class="o_back_button btn btn-link d-print-none px-1 py-0"
                    t-att-title="this.getBreadcrumbTooltip(previousBreadcrumb)"
                    t-on-click.prevent="previousBreadcrumb.onSelected"
                >
                    <i class="oi oi-fw oi-arrow-left" />
                </button>
                <div
                    t-if="collapsedBreadcrumbs.length"
                    class="d-inline-flex align-items-center d-print-none"
                >
                    <t t-call="spreadsheet_oca.Breadcrumbs.Collapsed" />
                </div>
            </t>
            <t t-else="">
                <ol class="breadcrumb flex-nowrap text-nowrap lh-sm">
                    <li
                        t-if="collapsedBreadcrumbs.length"
                        class="breadcrumb-item d-inline-flex"
                    >
                        <t t-call="spreadsheet_oca.Breadcrumbs.Collapsed" />
                    </li>
                    <li
                        class="breadcrumb-item d-inline-flex min-w-0 o_back_button"
                        data-hotkey="b"
                        t-on-click.prevent="previousBreadcrumb.onSelected"
                    >
                        <a
                            t-att-href="previousBreadcrumb.url"
                            class="fw-bold text-truncate"
                            t-att-data-tooltip="this.getBreadcrumbTooltip(previousBreadcrumb)"
                        >
                            <t
                                t-call="web.Breadcrumb.Name"
                                breadcrumb="previousBreadcrumb"
                            />
                        </a>
                    </li>
                </ol>
            </t>
            <div class="d-flex gap-1 text-truncate">
                <div
                    class="o_last_breadcrumb_item active d-flex gap-2 align-items-center min-w-0 lh-sm"
                >
                    <SpreadsheetName isReadonly="false" />
                </div>
                <t t-call="spreadsheet_oca.Breadcrumbs.Actions" />
            </div>
        </div>

        <div t-else="" class="o_breadcrumb d-flex gap-1 text-truncate">
            <div
                class="o_last_breadcrumb_item active d-flex fs-4 min-w-0 align-items-center"
            >
                <SpreadsheetName isReadonly="false" />
            </div>
            <t t-call="spreadsheet_oca.Breadcrumbs.Actions" />
        </div>

        <t t-call-slot="control-panel-status-indicator" />
    </t>
    <t t-name="spreadsheet_oca.PivotIcon" owl="1">
        <i class="fa fa-table" />
    </t>
    <t t-name="spreadsheet_oca.ListIcon" owl="1">
        <i class="fa fa-list" />
    </t>
    <!-- Derived from web.ControlPanel (saas-19.4) in a compact layout. The
         spreadsheet client action has no embedded actions, so that panel is
         left out, and the breadcrumbs are rendered in place on every screen
         size (see spreadsheet_oca.Breadcrumbs). -->
    <t t-name="spreadsheet_oca.SpreadsheetControlPanel" owl="1">
        <div
            class="o_control_panel o_spreadsheet_oca_compact_cp d-flex flex-column gap-0 px-2 pt-1 pb-1"
            t-custom-ref="root"
            data-command-category="actions"
        >
            <div
                class="o_control_panel_main d-flex flex-wrap flex-lg-nowrap justify-content-between align-items-lg-start gap-2 gap-lg-3 flex-grow-1"
            >
                <div
                    class="o_control_panel_breadcrumbs d-flex align-items-center gap-1 order-0 h-lg-100 min-w-0"
                >
                    <div
                        class="o_control_panel_main_buttons d-flex gap-1 d-empty-none d-print-none text-nowrap"
                        t-on-keydown="this.onMainButtonsKeydown"
                    >
                        <t
                            t-if="this.display.buttons"
                            t-call-slot="control-panel-buttons"
                        />
                    </div>
                    <t t-if="this.env.config.noBreadcrumbs">
                        <section
                            class="o_control_panel_breadcrumbs_actions d-contents d-print-none"
                        >
                            <t t-call-slot="control-panel-additional-actions" />
                            <t t-call-slot="control-panel-status-indicator" />
                        </section>
                    </t>
                    <t t-else="" t-call="spreadsheet_oca.Breadcrumbs" />
                    <div t-if="!this.env.isSmall" class="me-auto" />
                    <!-- Spacer -->
                </div>

                <div
                    class="o_control_panel_actions d-empty-none d-flex align-items-center justify-content-start justify-content-lg-around order-2 order-lg-1 w-100 mw-100 w-lg-auto"
                >
                    <t
                        t-if="this.display.actions"
                        t-call-slot="control-panel-actions"
                    />
                    <t t-call-slot="control-panel-selection-actions" />
                </div>

                <div
                    class="o_control_panel_navigation d-flex flex-wrap flex-md-nowrap justify-content-end gap-1 gap-xl-3 order-1 order-lg-2 flex-grow-1"
                >
                    <div
                        t-if="this.pagerProps and this.pagerProps.total > 0"
                        class="o_cp_pager text-nowrap "
                        role="search"
                    >
                        <Pager t-props="this.pagerProps" />
                    </div>
                    <t t-if="this.env.config.viewSwitcherEntries?.length > 1">
                        <div
                            t-if="this.env.isSmall"
                            class="o_cp_switch_buttons btn-group d-print-none"
                        >
                            <Dropdown
                                menuClass="{o_cp_switch_buttons: true, o_custom_bottom_sheet: true }"
                            >
                                <button
                                    class="btn btn-secondary"
                                    data-available-offline=""
                                >
                                    <t
                                        t-set="activeView"
                                        t-value="this.env.config.viewSwitcherEntries.find((view) => view.active)"
                                    />
                                    <i class="oi-fw" t-att-class="activeView.icon" />
                                </button>
                                <t t-set-slot="content">
                                    <t
                                        t-foreach="this.env.config.viewSwitcherEntries"
                                        t-as="view"
                                        t-key="view.type"
                                    >
                                        <DropdownItem
                                            tag="'button'"
                                            attrs="{ 'data-available-offline': this.isViewAvailable(view)}"
                                            onSelected="() => this.switchView(view.type)"
                                            class="{ 'selected': view.active }"
                                        >
                                            <i class="oi-fw" t-att-class="view.icon" />
                                            <span class="ms-1" t-out="view.name" />
                                        </DropdownItem>
                                    </t>
                                </t>
                            </Dropdown>
                        </div>
                        <nav
                            t-else=""
                            class="o_cp_switch_buttons d-print-none d-inline-flex btn-group"
                        >
                            <t
                                t-foreach="this.env.config.viewSwitcherEntries"
                                t-as="view"
                                t-key="view.type"
                            >
                                <button
                                    class="btn btn-secondary o_switch_view "
                                    t-att-class="{ 'active': view.active }"
                                    t-attf-class="o_{{view.type}}"
                                    t-att-data-available-offline="this.isViewAvailable(view)"
                                    t-att-data-tooltip="view.name"
                                    t-custom-click="(ev, isMiddleClick) => this.switchView(view.type, isMiddleClick)"
                                    t-att-aria-label="view.name"
                                >
                                    <i class="oi-fw" t-att-class="view.icon" />
                                </button>
                            </t>
                        </nav>
                    </t>
                    <t t-call-slot="control-panel-navigation-additional" />
                </div>
            </div>
        </div>
    </t>
    <t t-name="spreadsheet_oca.OdooChartDataSourcePanel" owl="1">
        <div class="o_spreadsheet_oca_chart_odoo_datasource">
            <div class="o-section o_spreadsheet_oca_chart_model">
                <div class="o-section-title">Model</div>
                <div class="text-break">
                    <t t-if="this.state.modelLabel"><t
                        t-out="this.state.modelLabel"
                    /> (<t t-out="this.resModel" />)</t>
                    <t t-else="" t-out="this.resModel" />
                </div>
            </div>
            <div class="o-section o_spreadsheet_oca_chart_measure">
                <div class="o-section-title">Measure</div>
                <div class="text-break" t-out="this.measureLabel" />
            </div>
            <div class="o-section o_spreadsheet_oca_chart_group_by">
                <div class="o-section-title">Group by</div>
                <t t-if="this.groupByLabels.length">
                    <div
                        t-foreach="this.groupByLabels"
                        t-as="groupByLabel"
                        t-key="groupByLabel_index"
                        class="text-break"
                        t-out="groupByLabel"
                    />
                </t>
                <div t-else="" class="text-muted">None</div>
            </div>
            <div class="o-section o_spreadsheet_oca_chart_domain">
                <div class="o-section-title">Domain</div>
                <DomainSelector
                    t-if="this.state.fields"
                    resModel="this.resModel"
                    domain="this.domain"
                    t-key="'chart_' + this.props.chartId + '_' + this.domain"
                />
                <code t-else="" class="text-break" t-out="this.domain" />
            </div>
            <div
                t-if="this.state.loadError"
                class="o-section pt-0 text-danger small o_spreadsheet_oca_chart_load_error"
                t-out="this.state.loadError"
            />
        </div>
    </t>
    <t t-name="spreadsheet_oca.ChartOdooMenuLink" owl="1">
        <div class="o-section o_spreadsheet_oca_chart_odoo_link">
            <div class="o-section-title">Link to Odoo menu</div>
            <div class="o-section-value">
                <Many2XAutocomplete t-props="this.menuProps" />
            </div>
            <div class="text-muted small mt-1">
                In a dashboard, clicking the chart opens this menu.
            </div>
        </div>
    </t>
    <t t-inherit="o-spreadsheet-ChartPanel" t-inherit-mode="extension">
        <!-- The side panel stays open when another chart is selected: rebuild
             the type picker, which lists the chart types supported by the data
             source of the chart once, in its setup. -->
        <xpath expr="//ChartTypePicker" position="attributes">
            <attribute name="t-key">this.chartId</attribute>
        </xpath>
        <xpath
            expr="//t[@t-component='this.chartPanel.configuration']"
            position="after"
        >
            <ChartOdooMenuLink chartId="this.chartId" t-key="this.chartId" />
        </xpath>
    </t>

</templates>
