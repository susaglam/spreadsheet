<odoo>
    <record model="ir.module.category" id="module_category_spreadsheet">
        <field name="name">Spreadsheet</field>
        <field name="sequence">99</field>
    </record>
    <record model="res.groups.privilege" id="privilege_spreadsheet">
        <field name="name">Spreadsheets</field>
        <field name="placeholder">No Access</field>
        <field name="category_id" ref="module_category_spreadsheet" />
        <field name="sequence">10</field>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_spreadsheet" />
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_spreadsheet" />
        <field name="implied_ids" eval="[(4, ref('group_user'))]" />
    </record>
    <!-- saas-19.4: ir.rule + ir.model.access merged into ir.access.
         access = OR(group permissions) AND AND(global restrictions), evaluated
         PER operation (a permission only counts for operations in its
         `operation` string). GLOBAL (no group) = restriction; GROUP = permission.
         The no-domain group_user crud grant on spreadsheet.spreadsheet was
         REMOVED from ir.access.csv so these owner/contributor/reader permissions
         are the sole scope (else OR with TRUE would expose every spreadsheet).
         perm_* -> operation letters (c,r,u,d): owner/manager=crud,
         contributor(no create/unlink)=ru, reader(read only)=r. -->
    <record model="ir.access" id="spreadsheet_company_rule">
        <field name="name">Spreadsheet Company Rule</field>
        <field name="model_id" ref="model_spreadsheet_spreadsheet" />
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record model="ir.access" id="spreadsheet_owner_rule">
        <field name="name">Spreadsheet Owner</field>
        <field name="model_id" ref="model_spreadsheet_spreadsheet" />
        <field name="group_id" ref="spreadsheet_oca.group_user" />
        <field name="operation">crud</field>
        <field name="domain">[('owner_id','=', user.id)]</field>
    </record>
    <record model="ir.access" id="spreadsheet_contributor_rule">
        <field name="name">Spreadsheet Contributor</field>
        <field name="model_id" ref="model_spreadsheet_spreadsheet" />
        <field name="group_id" ref="spreadsheet_oca.group_user" />
        <field name="operation">ru</field>
        <field
            name="domain"
        >['|', ('contributor_ids','=', user.id), ('contributor_group_ids','in', user.group_ids.ids)]</field>
    </record>
    <record model="ir.access" id="spreadsheet_reader_rule">
        <field name="name">Spreadsheet Reader</field>
        <field name="model_id" ref="model_spreadsheet_spreadsheet" />
        <field name="group_id" ref="spreadsheet_oca.group_user" />
        <field name="operation">r</field>
        <field
            name="domain"
        >['|', ('reader_ids','=', user.id), ('reader_group_ids','in', user.group_ids.ids)]</field>
    </record>
    <record model="ir.access" id="spreadsheet_manager_rule">
        <field name="name">Spreadsheet Manager</field>
        <field name="model_id" ref="model_spreadsheet_spreadsheet" />
        <field name="group_id" ref="spreadsheet_oca.group_manager" />
        <field name="operation">crud</field>
        <field name="domain">[(1,'=', 1)]</field>
    </record>
    <record model="ir.access" id="spreadsheet_import_mode_rule">
        <field name="name">Spreadsheet Import mode</field>
        <field name="model_id" ref="model_spreadsheet_spreadsheet_import_mode" />
        <field name="operation">crud</field>
        <field name="domain">[('group_ids','in', user.group_ids.ids)]</field>
    </record>
</odoo>
