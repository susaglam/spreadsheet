<odoo>
    <data noupdate="1">
        <record id="kpi_alert_email_template" model="mail.template">
            <field name="name">Spreadsheet KPI Alert</field>
            <field name="model_id" ref="model_spreadsheet_kpi_alert" />
            <field name="subject">KPI Alert: {{ object.name }}</field>
            <field
                name="email_to"
            >{{ (object.notify_user_ids.mapped('email') | join(',')) }}</field>
            <field
                name="body_html"
            ><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background-color: #875a7b; color: white; padding: 16px 24px;">
        <h2 style="margin: 0;">KPI Alert Triggered</h2>
    </div>
    <div style="padding: 24px; border: 1px solid #ddd; border-top: none;">
        <p>Hello,</p>
        <p>The following KPI alert has been triggered:</p>
        <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
            <tr>
                <td style="padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;">Alert</td>
                <td style="padding: 8px; border-bottom: 1px solid #eee;">{{ object.name }}</td>
            </tr>
            <tr>
                <td style="padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;">Spreadsheet</td>
                <td style="padding: 8px; border-bottom: 1px solid #eee;">{{ object.spreadsheet_id.name }}</td>
            </tr>
            <tr>
                <td style="padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;">Cell</td>
                <td style="padding: 8px; border-bottom: 1px solid #eee;">{{ object.sheet_name }}!{{ object.cell_ref }}</td>
            </tr>
            <tr>
                <td style="padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;">Current Value</td>
                <td style="padding: 8px; border-bottom: 1px solid #eee; color: #dc3545; font-weight: bold;">{{ object.last_value }}</td>
            </tr>
            <tr>
                <td style="padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;">Condition</td>
                <td style="padding: 8px; border-bottom: 1px solid #eee;">{{ object.operator }} {{ object.threshold_value }}</td>
            </tr>
        </table>
        <p style="color: #666; font-size: 12px;">
            This alert was triggered automatically. To manage your KPI alerts,
            open the spreadsheet and go to Data &gt; KPI Alerts.
        </p>
    </div>
</div>
]]></field>
        </record>
    </data>
</odoo>
