<odoo>
    <data noupdate="1">
        <record id="ir_cron_kpi_alert_check" model="ir.cron">
            <field name="name">Spreadsheet: KPI Alert Threshold Check</field>
            <field name="model_id" ref="model_spreadsheet_kpi_alert" />
            <field name="state">code</field>
            <field name="code">model._cron_check_kpi_thresholds()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root" />
            <field name="priority">10</field>
        </record>
    </data>
</odoo>
