<odoo>
    <!-- saas-19.4: ir.rule -> ir.access permissions (group_id set). The
         no-domain group_user crud grant on spreadsheet.kpi.alert was removed
         from ir.access.csv so this owner permission is the sole scope. -->
    <!-- Users can manage alerts on spreadsheets they have access to -->
    <record id="rule_kpi_alert_owner" model="ir.access">
        <field name="name">KPI Alert: Owner/Contributor Access</field>
        <field name="model_id" ref="model_spreadsheet_kpi_alert" />
        <field name="group_id" ref="spreadsheet_oca.group_user" />
        <field name="operation">crud</field>
        <field name="domain">[
            '|', '|',
            ('spreadsheet_id.owner_id', '=', user.id),
            ('spreadsheet_id.contributor_ids', '=', user.id),
            ('notify_user_ids', '=', user.id)
        ]</field>
    </record>

    <!-- Managers have full access to all alerts -->
    <record id="rule_kpi_alert_manager" model="ir.access">
        <field name="name">KPI Alert: Manager Full Access</field>
        <field name="model_id" ref="model_spreadsheet_kpi_alert" />
        <field name="group_id" ref="spreadsheet_oca.group_manager" />
        <field name="operation">crud</field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>
</odoo>
