#. module: spreadsheet_kpi_alert_oca
#: model:mail.template,body_html:spreadsheet_kpi_alert_oca.kpi_alert_email_template
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"    <div style=\"background-color: #875a7b; color: white; padding: 16px 24px;\">\n"
"        <h2 style=\"margin: 0;\">KPI Alert Triggered</h2>\n"
"    </div>\n"
"    <div style=\"padding: 24px; border: 1px solid #ddd; border-top: none;\">\n"
"        <p>Hello,</p>\n"
"        <p>The following KPI alert has been triggered:</p>\n"
"        <table style=\"width: 100%; border-collapse: collapse; margin: 16px 0;\">\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;\">Alert</td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\"><t t-out=\"object.name or ''\">Revenue Alert</t></td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;\">Spreadsheet</td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\"><t t-out=\"object.spreadsheet_id.name or ''\">Sales KPIs</t></td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;\">Cell</td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\"><t t-out=\"object.sheet_name or ''\">Sheet1</t>!<t t-out=\"object.cell_ref or ''\">B2</t></td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;\">Current Value</td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee; color: #dc3545; font-weight: bold;\"><t t-out=\"object.last_value\">950.0</t></td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;\">Condition</td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\"><t t-out=\"object.operator or ''\">&lt;</t> <t t-out=\"object.threshold_value\">1000.0</t></td>\n"
"            </tr>\n"
"        </table>\n"
"        <p style=\"color: #666; font-size: 12px;\">\n"
"            This alert was triggered automatically. To manage your KPI alerts,\n"
"            open the spreadsheet and go to Data &gt; KPI Alerts.\n"
"        </p>\n"
"    </div>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"    <div style=\"background-color: #875a7b; color: white; padding: 16px 24px;\">\n"
"        <h2 style=\"margin: 0;\">KPI-Alarm ausgelöst</h2>\n"
"    </div>\n"
"    <div style=\"padding: 24px; border: 1px solid #ddd; border-top: none;\">\n"
"        <p>Hallo,</p>\n"
"        <p>Der folgende KPI-Alarm wurde ausgelöst:</p>\n"
"        <table style=\"width: 100%; border-collapse: collapse; margin: 16px 0;\">\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;\">Alarm</td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\"><t t-out=\"object.name or ''\">Revenue Alert</t></td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;\">Tabelle</td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\"><t t-out=\"object.spreadsheet_id.name or ''\">Sales KPIs</t></td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;\">Zelle</td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\"><t t-out=\"object.sheet_name or ''\">Sheet1</t>!<t t-out=\"object.cell_ref or ''\">B2</t></td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;\">Aktueller Wert</td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee; color: #dc3545; font-weight: bold;\"><t t-out=\"object.last_value\">950.0</t></td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;\">Bedingung</td>\n"
"                <td style=\"padding: 8px; border-bottom: 1px solid #eee;\"><t t-out=\"object.operator or ''\">&lt;</t> <t t-out=\"object.threshold_value\">1000.0</t></td>\n"
"            </tr>\n"
"        </table>\n"
"        <p style=\"color: #666; font-size: 12px;\">\n"
"            Dieser Alarm wurde automatisch ausgelöst. Um Ihre KPI-Alarme zu verwalten,\n"
"            öffnen Sie die Tabelle und gehen Sie zu Daten &gt; KPI-Alarme.\n"
"        </p>\n"
"    </div>\n"
"</div>\n"
"            "

