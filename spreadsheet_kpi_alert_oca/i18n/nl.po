msgstr "Spreadsheet KPI-alert"

#. module: spreadsheet_kpi_alert_oca
#: model:ir.actions.server,name:spreadsheet_kpi_alert_oca.ir_cron_kpi_alert_check_ir_actions_server
msgid "Spreadsheet: KPI Alert Threshold Check"
msgstr "Spreadsheet: controle KPI-alertdrempels"

#. module: spreadsheet_kpi_alert_oca
#: model_terms:ir.ui.view,arch_db:spreadsheet_kpi_alert_oca.spreadsheet_kpi_alert_view_form
