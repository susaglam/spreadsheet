<odoo>
    <!-- saas-19.4: ir.rule -> ir.access permissions. The no-domain portal read
         grant on spreadsheet.portal.dashboard was removed from ir.access.csv so
         this scoped portal permission is the sole portal grant (else OR with
         TRUE would expose every dashboard). operation="r" (portal read-only). -->
    <!-- Portal users can read dashboards assigned to them -->
    <record id="rule_portal_dashboard_portal_read" model="ir.access">
        <field name="name">Portal Dashboard: Portal user read access</field>
        <field name="model_id" ref="model_spreadsheet_portal_dashboard" />
        <field name="group_id" ref="base.group_portal" />
        <field name="operation">r</field>
        <field name="domain">[
            '|',
            ('all_portal_users', '=', True),
            '|',
            ('partner_ids', '=', user.partner_id.id),
            ('partner_ids', '=', user.partner_id.commercial_partner_id.id)
        ]</field>
    </record>
</odoo>
