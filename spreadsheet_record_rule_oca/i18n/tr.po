#. module: spreadsheet_record_rule_oca
#: model:ir.model.fields,help:spreadsheet_record_rule_oca.field_spreadsheet_dashboard__rule_ids
msgid ""
"Data filter rules that narrow the pivot, list and chart data this dashboard "
"displays for specific groups of users. They are a display convenience, not a"
" security boundary: users never see more than their normal access rights "
"allow."
msgstr ""
"Bu rapor panelinin belirli kullanıcı gruplarına gösterdiği pivot, liste ve "
"grafik verilerini daraltan veri filtresi kuralları. Bunlar bir görüntüleme "
"kolaylığıdır, güvenlik sınırı değildir: kullanıcılar hiçbir zaman normal "
"erişim yetkilerinin izin verdiğinden fazlasını görmez."

#. module: spreadsheet_record_rule_oca
#: model:ir.model.fields,field_description:spreadsheet_record_rule_oca.field_spreadsheet_dashboard_rule__display_name
msgid "Display Name"
msgstr "Görünen Ad"

#. module: spreadsheet_record_rule_oca
#: model_terms:ir.ui.view,arch_db:spreadsheet_record_rule_oca.dashboard_rule_view_form
msgid "Display filter, not a security boundary."
msgstr "Görüntüleme filtresi, güvenlik sınırı değil."

#. module: spreadsheet_record_rule_oca
#: model_terms:ir.ui.view,arch_db:spreadsheet_record_rule_oca.dashboard_rule_view_form
