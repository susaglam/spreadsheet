#. module: spreadsheet_scheduled_refresh_oca
#: model:ir.model.constraint,message:spreadsheet_scheduled_refresh_oca.constraint_spreadsheet_refresh_schedule_interval_positive
msgid ""
"The refresh interval must be a positive number of intervals (e.g. 6 Hours)."
msgstr "Yenileme aralığı pozitif bir aralık sayısı olmalıdır (ör. 6 Saat)."

#. module: spreadsheet_scheduled_refresh_oca
#: model:ir.model.fields,help:spreadsheet_scheduled_refresh_oca.field_spreadsheet_refresh_schedule__spreadsheet_id
msgid "The spreadsheet whose data sources this schedule refreshes."
msgstr "Bu programın veri kaynaklarını yenilediği e-tablo."

#. module: spreadsheet_scheduled_refresh_oca
#: model:ir.model.fields,help:spreadsheet_scheduled_refresh_oca.field_spreadsheet_refresh_schedule__active
msgid ""
"Uncheck to pause this schedule without deleting it. The cron skips inactive "
"schedules, so open sheets stop receiving refresh signals until you enable it"
" again."
msgstr ""
"Bu programı silmeden duraklatmak için işareti kaldırın. Zamanlanmış görev "
"etkin olmayan programları atlar; siz yeniden etkinleştirene kadar açık "
"tablolar yenileme sinyali almaz."

#. module: spreadsheet_scheduled_refresh_oca
#: model:ir.model.fields,help:spreadsheet_scheduled_refresh_oca.field_spreadsheet_refresh_schedule__interval_type
msgid "Unit paired with the interval number (hours/days/weeks/months)."
msgstr "Aralık sayısıyla birlikte kullanılan birim (saat/gün/hafta/ay)."

#. module: spreadsheet_scheduled_refresh_oca
#: model:ir.model.fields.selection,name:spreadsheet_scheduled_refresh_oca.selection__spreadsheet_refresh_schedule__interval_type__weeks
