<odoo>
    <!-- Main PDF wrapper with header/footer. CONTROLLER-ONLY: rendered by
         /spreadsheet/pdf with values it builds itself (company, report_name,
         report_date, content, and page_size / page_margin computed from the
         report's paper format). page_size and page_margin are written inside
         <style>, where escaping does not stop CSS, so this template must never
         become the report_name of an ir.actions.report: the generic
         /report/<converter>/<reportname> route merges arbitrary client
         "options" into the rendering values. -->
    <template id="spreadsheet_pdf_main">
        <html lang="en">
            <head>
                <meta charset="UTF-8" />
                <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
                <style>
                    @page {
                        size: <t t-out="page_size or 'A4 landscape'" />;
                        margin: <t t-out="page_margin or '15mm 7mm'" />;
                    }
                    body {
                        font-family: 'DejaVu Sans', 'Liberation Sans', 'Arial Unicode MS', Arial, sans-serif;
                        font-size: 10px;
                        color: #333;
                        margin: 0;
                        padding: 0;
                    }
                    .report-header {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        border-bottom: 2px solid #333;
                        padding-bottom: 8px;
                        margin-bottom: 16px;
                    }
                    .report-header .company-info {
                        display: flex;
                        align-items: center;
                        gap: 12px;
                    }
                    .report-header .company-logo img {
                        max-height: 40px;
                        max-width: 150px;
                    }
                    .report-header .company-name {
                        font-size: 14px;
                        font-weight: bold;
                    }
                    .report-header .report-title {
                        font-size: 16px;
                        font-weight: bold;
                        color: #555;
                    }
                    .report-meta {
                        text-align: right;
                        font-size: 9px;
                        color: #888;
                        margin-bottom: 12px;
                    }
                    .sheet-section {
                        margin-bottom: 24px;
                        page-break-inside: avoid;
                    }
                    .sheet-title {
                        font-size: 13px;
                        font-weight: bold;
                        color: #444;
                        padding: 4px 8px;
                        background: #f0f0f0;
                        border-left: 4px solid #875a7b;
                        margin-bottom: 8px;
                    }
                    .sheet-table {
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: auto;
                        font-size: 9px;
                    }
                    .sheet-table td, .sheet-table th {
                        border: 1px solid #ccc;
                        padding: 3px 5px;
                        vertical-align: middle;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        max-width: 200px;
                    }
                    .report-footer {
                        margin-top: 16px;
                        padding-top: 8px;
                        border-top: 1px solid #ccc;
                        font-size: 8px;
                        color: #999;
                        display: flex;
                        justify-content: space-between;
                    }
                </style>
            </head>
            <body>
                <!-- Header -->
                <div class="report-header">
                    <div class="company-info">
                        <div class="company-logo" t-if="company and company.logo">
                            <img
                                t-att-src="image_data_uri(company.logo)"
                                alt="Company Logo"
                            />
                        </div>
                        <div class="company-name" t-out="company.name" />
                    </div>
                    <div class="report-title" t-out="report_name" />
                </div>

                <div class="report-meta">
                    <span>Generated on</span>
                    <t t-out="report_date" />
                </div>

                <!-- Sheet content -->
                <t t-out="content" />

                <!-- Footer -->
                <div class="report-footer">
                    <span t-out="company.name" />
                    <span t-out="report_name" />
                </div>
            </body>
        </html>
    </template>

    <!-- Sheet content rendering. Cells arrive already validated by the
         controller (normalize_payload): "style" is rebuilt server-side from
         whitelisted values, so no client string is concatenated here. -->
    <template id="spreadsheet_pdf_content">
        <t t-foreach="sheets or []" t-as="sheet">
            <div class="sheet-section">
                <div class="sheet-title">
                    <t t-out="sheet['name']" />
                </div>
                <t t-if="sheet['rows']">
                    <table class="sheet-table">
                        <t t-foreach="sheet['rows']" t-as="row">
                            <tr>
                                <t t-foreach="row" t-as="cell">
                                    <td
                                        t-att-style="cell['style'] or None"
                                        t-att-colspan="cell['colspan'] or None"
                                        t-att-rowspan="cell['rowspan'] or None"
                                    >
                                        <t t-out="cell['value']" />
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </table>
                </t>
                <t t-else="">
                    <p style="color: #999; font-style: italic;">
                        <span>Empty sheet</span>
                    </p>
                </t>
            </div>
        </t>
    </template>

    <!-- Stub document of the report action below. The action only carries
         settings (paper format, engine), the real export is rendered by the
         /spreadsheet/pdf controller. Opening the action through the generic
         /report/<converter>/ route renders this static page: it reads no
         request values, and its <main> keeps both PDF engines working. -->
    <template id="report_spreadsheet_pdf_placeholder">
        <t t-call="web.basic_layout">
            <div class="page">
                <p>
                    This report only holds the paper format and PDF engine settings of the spreadsheet PDF export. To export a spreadsheet, open it and use File &gt; Download PDF.
                </p>
            </div>
        </t>
    </template>

    <!-- Report action: not bound to any model menu. It carries the paper
         format of the export and lets an administrator pick a dedicated PDF
         engine (Report Type "PDF (Wkhtmltopdf)" / "PDF (Paper Muncher)") in
         Settings > Technical > Actions > Reports; with plain "PDF" the system
         parameter report.pdf_engine_default decides, like every other Odoo
         report. report_name points at the stub, never at
         spreadsheet_pdf_main (see the comment on that template). -->
    <record id="action_report_spreadsheet_pdf" model="ir.actions.report">
        <field name="name">Spreadsheet PDF Export</field>
        <field name="model">spreadsheet.spreadsheet</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >spreadsheet_pdf_report_oca.report_spreadsheet_pdf_placeholder</field>
        <field
            name="report_file"
        >spreadsheet_pdf_report_oca.report_spreadsheet_pdf_placeholder</field>
        <field name="paperformat_id" ref="paperformat_spreadsheet_landscape" />
    </record>
</odoo>
