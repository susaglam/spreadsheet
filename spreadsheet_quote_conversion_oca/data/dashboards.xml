<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="spreadsheet_dashboard_quote_conversion" model="spreadsheet.dashboard">
        <field name="name">Quote-to-Order Conversion</field>
        <field
            name="spreadsheet_binary_data"
            type="base64"
            file="spreadsheet_quote_conversion_oca/data/files/quote_conversion_dashboard.json"
        />
        <field
            name="dashboard_group_id"
            ref="spreadsheet_dashboard.spreadsheet_dashboard_group_sales"
        />
        <field
            name="group_ids"
            eval="[Command.link(ref('sales_team.group_sale_salesman'))]"
        />
        <field name="sequence">120</field>
    </record>
</odoo>
