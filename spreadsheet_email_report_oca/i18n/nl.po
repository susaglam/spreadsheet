#. module: spreadsheet_email_report_oca
#. odoo-python
#: code:addons/spreadsheet_email_report_oca/models/email_report.py:0
msgid "Report '%(report)s' has been sent to recipients."
msgstr "Rapport '%(report)s' is naar de ontvangers verzonden."

#. module: spreadsheet_email_report_oca
#. odoo-python
#: code:addons/spreadsheet_email_report_oca/models/email_report.py:0
msgid ""
"Report '%(report)s' has invalid addresses in Extra Emails: %(addresses)s. "
"Mail to a malformed address is never delivered, so those people would "
"silently miss the report. Separate addresses with commas and write each one "
"as name@example.com."
msgstr ""
"Rapport '%(report)s' bevat ongeldige adressen in Extra e-mailadressen: "
"%(addresses)s. E-mail naar een onjuist adres wordt nooit bezorgd, dus die "
"personen zouden het rapport ongemerkt missen. Scheid adressen met komma's en"
" schrijf elk adres als naam@example.com."

#. module: spreadsheet_email_report_oca
#. odoo-python
#: code:addons/spreadsheet_email_report_oca/models/email_report.py:0
msgid ""
"Report '%(report)s' was not sent: no recipient has a valid email address, or"
" the mail template is missing. Add an email to a recipient partner or fill "
"Extra Emails."
msgstr ""
"Rapport '%(report)s' is niet verzonden: geen enkele ontvanger heeft een "
"geldig e-mailadres, of de e-mailsjabloon ontbreekt. Voeg een e-mailadres toe"
" aan een ontvanger of vul Extra e-mailadressen in."

