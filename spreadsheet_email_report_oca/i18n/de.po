#: code:addons/spreadsheet_email_report_oca/models/email_report.py:0
msgid "Report '%(report)s' has been sent to recipients."
msgstr "Der Bericht „%(report)s“ wurde an die Empfänger gesendet."

#. module: spreadsheet_email_report_oca
#. odoo-python
#: code:addons/spreadsheet_email_report_oca/models/email_report.py:0
msgid ""
"Report '%(report)s' has invalid addresses in Extra Emails: %(addresses)s. "
"Mail to a malformed address is never delivered, so those people would "
"silently miss the report. Separate addresses with commas and write each one "
"as name@example.com."
msgstr ""
"Der Bericht „%(report)s“ enthält ungültige Adressen unter „Zusätzliche "
"E-Mail-Adressen“: %(addresses)s. E-Mails an fehlerhafte Adressen werden nie "
"zugestellt, diese Personen würden den Bericht also unbemerkt nicht erhalten."
" Trennen Sie Adressen durch Kommas und schreiben Sie jede im Format "
"name@example.com."

#. module: spreadsheet_email_report_oca
#. odoo-python
#: code:addons/spreadsheet_email_report_oca/models/email_report.py:0
msgid ""
"Report '%(report)s' was not sent: no recipient has a valid email address, or"
" the mail template is missing. Add an email to a recipient partner or fill "
"Extra Emails."
msgstr ""
"Der Bericht „%(report)s“ wurde nicht gesendet: Kein Empfänger hat eine "
"gültige E-Mail-Adresse, oder die E-Mail-Vorlage fehlt. Hinterlegen Sie bei "
"einem Empfänger eine E-Mail-Adresse oder füllen Sie „Zusätzliche E-Mail-"
"Adressen“ aus."

