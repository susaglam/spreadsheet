#. module: spreadsheet_email_report_oca
#. odoo-python
#: code:addons/spreadsheet_email_report_oca/models/email_report.py:0
msgid ""
"%(owner)s cannot open the spreadsheet '%(spreadsheet)s', so they cannot own "
"the scheduled report '%(report)s'. Reports are sent with their owner's "
"access rights, and emailing a workbook the owner may not read would leak "
"data. Share the spreadsheet with %(owner)s (as reader or contributor) or "
"choose another owner."
msgstr ""

#. module: spreadsheet_email_report_oca
#: model:mail.template,body_html:spreadsheet_email_report_oca.spreadsheet_email_report_template
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"    <div style=\"background-color: #875a7b; color: white; padding: 16px 24px;\">\n"
"        <h2 style=\"margin: 0;\" t-out=\"object.spreadsheet_id.name or ''\">Weekly Sales</h2>\n"
"    </div>\n"
"    <div style=\"padding: 24px; border: 1px solid #ddd; border-top: none;\">\n"
"        <p>Hello,</p>\n"
"        <p>Please find attached the scheduled report <strong t-out=\"object.name or ''\">Weekly Sales Dashboard</strong>.</p>\n"
"        <p>Generated on: <t t-out=\"format_datetime(ctx.get('report_generated_at') or object.last_sent or object.create_date, tz=object.owner_id.tz)\">2026-01-05 08:00:00</t></p>\n"
"        <p style=\"color: #666; font-size: 12px;\">\n"
"            This is an automated report sent by your Odoo instance.\n"
"        </p>\n"
"    </div>\n"
"</div>\n"
"            "
msgstr ""

