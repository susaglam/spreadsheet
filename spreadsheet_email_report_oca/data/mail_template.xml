<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- body_html is rendered with QWeb (render_engine='qweb'): values in text
         must use <t t-out="..."/>; {{ }} is only interpolated in t-attf-*
         attributes. subject / email_from are inline templates, where {{ }} is
         correct. This record is noupdate: existing databases are brought in
         line by migrations/saas~19.4.1.1.2/post-migrate.py. -->
    <record id="spreadsheet_email_report_template" model="mail.template">
        <field name="name">Spreadsheet Scheduled Report</field>
        <field name="model_id" ref="model_spreadsheet_email_report" />
        <field
            name="subject"
        >{{ object.name }} - {{ object.spreadsheet_id.name }}</field>
        <field
            name="email_from"
        >{{ (object.owner_id.email_formatted or object.owner_id.company_id.email_formatted or user.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="body_html" type="html">
            <div
                style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;"
            >
                <div
                    style="background-color: #875a7b; color: white; padding: 16px 24px;"
                >
                    <h2
                        style="margin: 0;"
                        t-out="object.spreadsheet_id.name or ''"
                    >Weekly Sales</h2>
                </div>
                <div style="padding: 24px; border: 1px solid #ddd; border-top: none;">
                    <p>Hello,</p>
                    <p>Please find attached the scheduled report <strong
                        t-out="object.name or ''"
                    >Weekly Sales Dashboard</strong>.</p>
                    <p>Generated on: <t
                        t-out="format_datetime(ctx.get('report_generated_at') or object.last_sent or object.create_date, tz=object.owner_id.tz)"
                    >2026-01-05 08:00:00</t></p>
                    <p style="color: #666; font-size: 12px;">
            This is an automated report sent by your Odoo instance.
        </p>
                </div>
            </div>
        </field>
    </record>
</odoo>
