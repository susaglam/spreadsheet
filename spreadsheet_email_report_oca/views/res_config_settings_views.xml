<odoo>
    <record id="res_config_settings_view_form_spreadsheet_email" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.spreadsheet.email</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="103" />
        <field
            name="inherit_id"
            ref="spreadsheet_kpi_alert_oca.res_config_settings_view_form_spreadsheet_kpi"
        />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='spreadsheet_oca']" position="inside">
                <block title="Email Reports" name="email_report_settings_block">
                    <setting
                        help="Default attachment format for scheduled email reports."
                    >
                        <field name="email_report_default_format" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
