<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="spreadsheet_dashboard_stock_overview" model="spreadsheet.dashboard">
        <field name="name">Inventory</field>
        <field
            name="spreadsheet_binary_data"
            type="base64"
            file="spreadsheet_dashboard_stock_oca/data/files/stock_dashboard.json"
        />
        <field
            name="dashboard_group_id"
            ref="spreadsheet_dashboard.spreadsheet_dashboard_group_logistics"
        />
        <field name="group_ids" eval="[Command.link(ref('stock.group_stock_user'))]" />
        <field name="sequence">110</field>
    </record>
</odoo>
