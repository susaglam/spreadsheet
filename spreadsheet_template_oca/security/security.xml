<odoo>
    <!-- Template Manager: implied by Spreadsheet Manager privilege.
         saas-19.2: res.groups no longer has category_id/users fields —
         use privilege_id and user_ids. -->
    <record id="group_template_manager" model="res.groups">
        <field name="name">Template Manager</field>
        <field name="privilege_id" ref="spreadsheet_oca.privilege_spreadsheet" />
        <field name="implied_ids" eval="[(4, ref('spreadsheet_oca.group_user'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
    </record>

    <!-- Spreadsheet Manager automatically gets Template Manager -->
    <record id="spreadsheet_oca.group_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_template_manager'))]" />
    </record>

    <!-- saas-19.4: ir.rule -> ir.access permissions. read_all = group_user read
         (matches the read-only ir.access.csv grant; no create/unlink so
         operation="r"); manager = full crud. Both domains are (1=1) = all. -->
    <!-- Templates: all spreadsheet users can read -->
    <record id="rule_spreadsheet_template_read_all" model="ir.access">
        <field name="name">Spreadsheet Template: Read for all users</field>
        <field name="model_id" ref="model_spreadsheet_template" />
        <field name="group_id" ref="spreadsheet_oca.group_user" />
        <field name="operation">r</field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>

    <!-- Templates: full access for template managers -->
    <record id="rule_spreadsheet_template_manager" model="ir.access">
        <field name="name">Spreadsheet Template: Full access for managers</field>
        <field name="model_id" ref="model_spreadsheet_template" />
        <field name="group_id" ref="spreadsheet_template_oca.group_template_manager" />
        <field name="operation">crud</field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>
</odoo>
