<odoo>
    <record id="spreadsheet_from_template_view_form" model="ir.ui.view">
        <field name="name">spreadsheet.from.template.view.form</field>
        <field name="model">spreadsheet.from.template</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="template_id" />
                    <field name="name" />
                </group>
                <footer>
                    <button
                        string="Create Spreadsheet"
                        name="create_spreadsheet"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
