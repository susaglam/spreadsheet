<odoo>
    <record id="spreadsheet_template_category_view_list" model="ir.ui.view">
        <field name="name">spreadsheet.template.category.list</field>
        <field name="model">spreadsheet.template.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="template_count" string="Templates" />
            </list>
        </field>
    </record>

    <record id="spreadsheet_template_category_view_form" model="ir.ui.view">
        <field name="name">spreadsheet.template.category.form</field>
        <field name="model">spreadsheet.template.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Category name..." />
                        </h1>
                    </div>
                    <group>
                        <field name="sequence" />
                        <field name="color" widget="color_picker" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="spreadsheet_template_category_act_window" model="ir.actions.act_window">
        <field name="name">Template Categories</field>
        <field name="res_model">spreadsheet.template.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No categories yet</p>
            <p>
                Create categories such as Sales, Finance or HR to group your
                spreadsheet templates. Categories appear in the template
                gallery's search panel so users can filter by theme.
            </p>
        </field>
    </record>
</odoo>
