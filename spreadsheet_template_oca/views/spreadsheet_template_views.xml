<odoo>
    <!-- Search view -->
    <record id="spreadsheet_template_view_search" model="ir.ui.view">
        <field name="name">spreadsheet.template.search</field>
        <field name="model">spreadsheet.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="category_id" />
                <field name="description" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group>
                    <filter
                        name="group_by_category"
                        string="Category"
                        context="{'group_by': 'category_id'}"
                    />
                </group>
                <searchpanel>
                    <field name="category_id" icon="fa-folder" enable_counters="1" />
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Kanban view -->
    <record id="spreadsheet_template_view_kanban" model="ir.ui.view">
        <field name="name">spreadsheet.template.kanban</field>
        <field name="model">spreadsheet.template</field>
        <field name="arch" type="xml">
            <kanban archivable="1" can_open="0">
                <templates>
                    <t t-name="menu">
                        <a
                            t-if="widget.editable"
                            type="open"
                            class="dropdown-item"
                        >Edit</a>
                        <a
                            t-if="widget.deletable"
                            type="delete"
                            class="dropdown-item"
                        >Delete</a>
                    </t>
                    <t t-name="card" class="flex-row">
                        <widget
                            name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"
                        />
                        <aside class="o_kanban_aside_full">
                            <div class="o_kanban_image_fill position-relative w-100">
                                <t t-if="record.thumbnail.raw_value">
                                    <field
                                        name="thumbnail"
                                        class="h-100"
                                        widget="image"
                                        options="{'img_class': 'object-fit-cover'}"
                                    />
                                </t>
                                <t t-else="">
                                    <img
                                        class="h-100 img-fluid"
                                        src="/spreadsheet_oca/static/description/icon.png"
                                        alt="Template Preview"
                                    />
                                </t>
                            </div>
                        </aside>
                        <main class="ps-2 ps-md-0">
                            <div class="mb-1">
                                <field class="fw-bold fs-4" name="name" />
                                <div
                                    class="text-muted small mt-1"
                                    t-if="record.description.raw_value"
                                >
                                    <field name="description" />
                                </div>
                            </div>
                            <footer>
                                <field
                                    name="category_id"
                                    widget="badge"
                                    class="text-muted"
                                />
                                <div class="ms-auto">
                                    <button
                                        name="action_create_spreadsheet"
                                        type="object"
                                        class="btn btn-sm btn-primary"
                                        string="Use Template"
                                    />
                                </div>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List view -->
    <record id="spreadsheet_template_view_list" model="ir.ui.view">
        <field name="name">spreadsheet.template.list</field>
        <field name="model">spreadsheet.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="category_id" />
                <field name="usage_count" string="Used" />
                <field name="active" column_invisible="1" />
                <button
                    name="action_create_spreadsheet"
                    type="object"
                    string="Use"
                    icon="fa-plus"
                />
                <button
                    name="open_spreadsheet"
                    type="object"
                    string="Edit"
                    icon="fa-pencil"
                    groups="spreadsheet_template_oca.group_template_manager"
                />
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="spreadsheet_template_view_form" model="ir.ui.view">
        <field name="name">spreadsheet.template.form</field>
        <field name="model">spreadsheet.template</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <field name="active" invisible="1" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div name="button_box" class="oe_button_box">
                        <button
                            name="open_spreadsheet"
                            type="object"
                            string="Edit Template"
                            icon="fa-pencil"
                            groups="spreadsheet_template_oca.group_template_manager"
                        />
                        <button
                            name="action_create_spreadsheet"
                            type="object"
                            string="Use Template"
                            icon="fa-plus"
                            class="btn-primary"
                        />
                    </div>
                    <field
                        name="thumbnail"
                        widget="image"
                        class="oe_avatar"
                        options="{'size': [128, 128]}"
                    />
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Monthly Sales Report"
                            />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id" />
                            <field name="sequence" />
                            <field name="usage_count" readonly="1" />
                        </group>
                        <group>
                            <field name="description" />
                        </group>
                        <group colspan="4">
                            <field
                                name="spreadsheet_binary_data"
                                groups="base.group_no_one"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="spreadsheet_template_act_window" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">spreadsheet.template</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
