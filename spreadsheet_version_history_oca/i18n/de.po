#. module: spreadsheet_version_history_oca
#. odoo-python
#: code:addons/spreadsheet_version_history_oca/models/spreadsheet_spreadsheet.py:0
msgid ""
"<p class='o_view_nocontent_smiling_face'>No snapshots yet</p><p>Use 'New "
"Snapshot' on the spreadsheet form to capture its current state, then diff or"
" restore it from here.</p>"
msgstr ""
"<p class='o_view_nocontent_smiling_face'>Noch keine "
"Schnappschüsse</p><p>Verwenden Sie „Neuer Schnappschuss“ im "
"Tabellenformular, um den aktuellen Stand festzuhalten, und vergleichen oder "
"stellen Sie ihn anschließend hier wieder her.</p>"

#. module: spreadsheet_version_history_oca
#. odoo-python
#: code:addons/spreadsheet_version_history_oca/models/spreadsheet_version.py:0
