msgid "%(a)s added, %(c)s changed, %(r)s removed."
msgstr "%(a)s hinzugefügt, %(c)s geändert, %(r)s entfernt."

#. module: spreadsheet_version_history_oca
#. odoo-python
#: code:addons/spreadsheet_version_history_oca/models/spreadsheet_version.py:0
msgid ""
"%(count)s more differences are not listed, to keep this page fast. The "
"summary above counts them all; open the spreadsheet to review them."
msgstr ""
"%(count)s weitere Unterschiede werden nicht aufgeführt, damit diese Seite "
"schnell bleibt. Die Zusammenfassung oben zählt sie alle mit; öffnen Sie die "
"Tabelle, um sie zu prüfen."

#. module: spreadsheet_version_history_oca
