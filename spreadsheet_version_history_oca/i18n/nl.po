#. module: spreadsheet_version_history_oca
#. odoo-python
#: code:addons/spreadsheet_version_history_oca/models/spreadsheet_spreadsheet.py:0
msgid ""
"<p class='o_view_nocontent_smiling_face'>No snapshots yet</p><p>Use 'New "
"Snapshot' on the spreadsheet form to capture its current state, then diff or"
" restore it from here.</p>"
msgstr ""
"<p class='o_view_nocontent_smiling_face'>Nog geen "
"momentopnamen</p><p>Gebruik 'Nieuwe momentopname' op het "
"spreadsheetformulier om de huidige staat vast te leggen, en vergelijk of "
"herstel die daarna hier.</p>"

